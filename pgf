#!/bin/bash
#
# pgf: the one entry point for porousGasificationFoam (#264, #274). See doc/pgf.md.
# what:    settings, isolated builds, runs in a clean environment, test tiers
# why:     one front door instead of hand-sourcing OpenFOAM; each build gets its own prefix
# instead: ./Allwmake / ./Allwclean when the OpenFOAM-style entry point is all you need
#
# The help pages, options and command table are in utilities/pgf/cli.sh (pgf help);
# the output style is utilities/pgf/ui.sh. Exit 2 when the environment cannot
# be set up; otherwise the command's status.

# readlink -f: pgf is usually called through the ~/.local/bin/pgf symlink.
PGF_ROOT="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
SELF="$PGF_ROOT/pgf"
PGF_LIB="$PGF_ROOT/utilities/pgf"

die() {
  echo "pgf: $*" >&2
  exit 2
}

# --color WHEN anywhere before "--" sets PGF_COLOR for pgf and what it runs.
args=()
while [ $# -gt 0 ]; do
  case "$1" in
  --) args+=("$@"); break ;;
  --color=*) export PGF_COLOR="${1#--color=}" ;;
  --color) export PGF_COLOR="${2:-}"; shift ;;
  *) args+=("$1") ;;
  esac
  shift
done
set -- "${args[@]}"
case "${PGF_COLOR:-auto}" in auto | always | never) ;; *) die "--color takes auto, always or never, not '$PGF_COLOR'" ;; esac

# pgf_help [CMD | TOPIC | --all] — the global help page, CMD's, TOPIC's, or all.
pgf_help() {
  . "$PGF_LIB/ui.sh"
  . "$PGF_LIB/config.sh"
  . "$PGF_LIB/cli.sh"
  if [ -z "${1:-}" ]; then pgf_cli_help; exit 0; fi
  if [ "$1" = --all ]; then
    # Paged like man on a terminal; plain when piped.
    if [ -t 1 ]; then pgf_cli_help_all | LESS="${LESS:-FRX}" ${PAGER:-less}; else pgf_cli_help_all; fi
    exit 0
  fi
  pgf_cli_help_topic "$1" && exit 0
  pgf_cli_help_cmd "$1" || die "unknown command or topic '$1' (see pgf help)"
  exit 0
}

# wants_help ARGS — -h/--help among the options: before "--", and for run
#   before the case dir.
wants_help() {
  local sub="$1" a
  shift
  for a in "$@"; do
    case "$a" in
    -h | --help) return 0 ;;
    --) return 1 ;;
    -*) ;;
    *) [ "$sub" = run ] && return 1 ;;
    esac
  done
  return 1
}

case "${1:-}" in
help) case "${2:-}" in -h | --help) pgf_help help ;; *) pgf_help "${2:-}" ;; esac ;;
-h | --help) pgf_help ;;
esac
[ -n "${1:-}" ] && wants_help "$@" && pgf_help "$1"

# pgf test keeps the caller's environment; it calls pgf shell itself. pgf view
# runs the caller's ParaView.
[ "${1:-}" = test ] && { shift; exec "$PGF_LIB/test.sh" "$@"; }
[ "${1:-}" = view ] && { shift; exec "$PGF_ROOT/applications/utilities/paraview/pgfView" "$@"; }

# -- 1. drop the caller's environment ------------------------------------------

if [ -z "${PGF_ENV_ACTIVE:-}" ]; then
  keep=()
  for v in HOME USER LANG TERM TMPDIR NO_COLOR WM_PROJECT_DIR XDG_CONFIG_HOME XDG_STATE_HOME; do
    [ -n "${!v+x}" ] && keep+=("$v=${!v}")
  done
  while IFS= read -r v; do
    keep+=("$v=${!v}")
  done < <(compgen -e | grep -E '^(PGF_|YADE_)')
  # The caller's PATH is kept aside only to find yade; PATH is rebuilt below.
  exec env -i "${keep[@]}" PGF_ENV_CALLER_PATH="$PATH" PGF_ENV_ACTIVE=0 \
    /bin/bash "$SELF" "$@"
fi

# -- arguments -----------------------------------------------------------------

. "$PGF_LIB/ui.sh"
. "$PGF_LIB/config.sh"
. "$PGF_LIB/commands.sh"
. "$PGF_LIB/coupling.sh"
. "$PGF_LIB/mpi.sh"
. "$PGF_LIB/pack.sh"
. "$PGF_LIB/cli.sh"

pgf_args=("$@") # pgf run hands them to the checkout a case copy came from
sub="status"
was_exec=0
case "${1:-}" in
status | doctor | setup | config | build | builds | copy | use | gc | pack | shell | run | tools | completion | __complete) sub="$1"; shift ;;
where | ls | exec) # old names (#287)
  [ "$1" = exec ] && was_exec=1
  sub="${PGF_CMD_ALIAS[$1]}"
  shift
  ;;
-*) die "give a command first, e.g. pgf shell $* (see pgf help)" ;;
"") ;;
*) die "unknown command '$1' (see pgf help)" ;;
esac

case "$sub" in
config) pgf_config_cmd "$@"; exit $? ;;
tools) pgf_tools_cmd "$@"; exit $? ;;
completion) pgf_completion_cmd "$@"; exit $? ;;
__complete) pgf_complete_cmd "$@"; exit $? ;;
build) pgf_build_cmd "$@"; exit $? ;;
builds) pgf_ls_cmd "$@"; exit $? ;;
copy) pgf_copy_cmd "$@"; exit $? ;;
use) pgf_use_cmd "$@"; exit $? ;;
gc) pgf_gc_cmd "$@"; exit $? ;;
pack) pgf_pack_cmd "$@"; exit $? ;;
status)
  # Another checkout answers for itself.
  if [ -n "${1:-}" ] && [ "${1#-}" = "$1" ]; then
    [ -x "$1/pgf" ] || die "$1 is not a porousGasificationFoam checkout (no $1/pgf)"
    there="$1"
    shift
    exec "$there/pgf" status "$@"
  fi
  ;;
esac

setup_layer="user"
setup_yes=0
setup_link=1
setup_completion=1
shell_cmd=""
force=0
json=0
run_build=0
allow_stale=0
raw_prefix=0

mode="tree"
prefix=""
cmd=()
while [ $# -gt 0 ]; do
  case "$1" in
  --use | --prefix)
    [ -n "${2:-}" ] || die "$1 needs an argument"
    mode="tree"
    sel="$2"
    raw_prefix=0
    [ "$1" = --prefix ] && { sel="$(cd "$2" 2>/dev/null && pwd -P)" || die "prefix not found: $2"; raw_prefix=1; }
    PGF_CONF_CLI[PGF_BUILD]="$sel"
    shift 2
    ;;
  --for-tree) mode="tree"; PGF_CONF_CLI[PGF_BUILD]=auto; shift ;;
  --build | --allow-stale)
    [ "$sub" = run ] || die "$1 is a 'pgf run' option"
    [ "$1" = --build ] && run_build=1 || allow_stale=1
    shift
    ;;
  --bare) mode="bare"; shift ;;
  --yade) PGF_CONF_CLI[PGF_YADE]=1; shift ;;
  --no-yade) PGF_CONF_CLI[PGF_YADE]=0; shift ;;
  --mpi)
    msg="$(pgf_conf_set_cli "PGF_MPI=${2:-}")" || die "--mpi: ${msg#--set: }"
    PGF_CONF_CLI[PGF_MPI]="$2"
    shift 2
    ;;
  --set | --foam-bashrc | --yade-bin | --yade-trunk)
    [ -n "${2:-}" ] || die "$1 needs an argument"
    case "$1" in
    --set) kv="$2" ;;
    --foam-bashrc) kv="PGF_FOAM_BASHRC=$2" ;;
    --yade-bin) kv="YADE_BIN=$2" ;;
    --yade-trunk) kv="YADE_TRUNK=$2" ;;
    esac
    msg="$(pgf_conf_set_cli "$kv")" || die "$msg"
    PGF_CONF_CLI[${kv%%=*}]="${kv#*=}"
    shift 2
    ;;
  --user | --checkout) setup_layer="${1#--}"; shift ;;
  -y | --yes) setup_yes=1; shift ;;
  --no-link) setup_link=0; shift ;;
  --no-completion) setup_completion=0; shift ;;
  --link-only) setup_link=2; shift ;;
  --force) force=1; shift ;;
  --json)
    [ "$sub" = "status" ] || die "--json is a 'pgf status' option"
    json=1
    shift
    ;;
  -c)
    [ "$sub" = "shell" ] || die "-c is a 'pgf shell' option"
    shell_cmd="${2:-}"
    shift 2
    ;;
  --) shift; break ;;
  -*) die "unknown option '$1' (the command goes after --)" ;;
  *)
    [ "$sub" = "run" ] && break
    die "unexpected '$1' (the command goes after --)"
    ;;
  esac
done

# A case made by pgf copy runs with the build of the checkout it came from,
# unless a build was chosen; that checkout's pgf takes over. Not inside a pgf
# image: a host checkout seen through the $HOME bind would run host code (#297).
if [ "$sub" = run ] && [ -n "${1:-}" ] && [ -f "$1/.pgf-source.json" ] && [ -z "${PGF_RUN_FROM_COPY:-}" ] &&
  [ -z "${PGF_IMAGE_MANIFEST:-}" ] &&
  [ -z "${PGF_CONF_CLI[PGF_BUILD]+x}" ] && [ -z "${PGF_BUILD+x}" ]; then
  from="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("checkout") or "")' "$1/.pgf-source.json" 2>/dev/null)"
  if [ -n "$from" ] && [ -x "$from/pgf" ] && [ "$(cd "$from" && pwd -P)" != "$(cd "$PGF_ROOT" && pwd -P)" ]; then
    export PGF_RUN_FROM_COPY=1
    exec "$from/pgf" "${pgf_args[@]}"
  fi
fi

if [ "$sub" = "setup" ]; then
  # Full setup prints one step line each; --link-only keeps its own lines.
  if [ "$setup_link" -eq 2 ]; then
    pgf_install_link "$force"
    exit $?
  fi
  PGF_SETUP_QUIET=1
  st_head "pgf setup"
  pgf_init "$setup_layer" "$setup_yes" || exit 2
  # A refused link is reported by the step line, which gives the fix.
  [ "$setup_link" -eq 0 ] || pgf_install_link "$force"
  pgf_setup_step_link "$setup_link"
  if [ "$setup_completion" -eq 1 ]; then
    ask=0
    [ "$setup_yes" -eq 0 ] && [ -t 0 ] && [ -r /dev/tty ] && ask=1
    pgf_install_completion "$ask" || exit $?
    if [ "${PGF_COMPLETION_INSTALLED:-0}" -eq 1 ]; then
      st_step "installing bash completion" OK "$(pgf_tilde "$(pgf_completion_file)"); new shells pick it up"
    else
      st_step "installing bash completion" skipped "(you said no)"
    fi
  fi
  pgf_setup_outcome
  exit 0
fi

pgf_conf_resolve || die "$PGF_CONF_ERR"
yade="$PGF_YADE"
mpi="$PGF_MPI"
sel="${PGF_BUILD:-auto}"
sel_src="${PGF_CONF_SRC[PGF_BUILD]:-default}"
[ "$sel_src" = env ] && sel_src="terminal"
[ "$raw_prefix" -eq 1 ] && [ "$sel_src" = cli ] && sel_src="--prefix"

if [ "$sub" = "status" ]; then
  [ "$json" -eq 1 ] && { pgf_status_json; exit $?; }
  pgf_status
  exit 0
fi
if [ "$sub" = "doctor" ]; then
  pgf_doctor
  exit $?
fi

case "$sub" in
shell)
  [ "$was_exec" -eq 0 ] || [ $# -gt 0 ] || die "no command given (usage: pgf shell [options] -- <command ...>)"
  [ $# -eq 0 ] || [ -z "$shell_cmd" ] || die "give -c COMMAND or -- COMMAND, not both"
  [ $# -eq 0 ] || cmd=("$@")
  ;;
run)
  [ $# -gt 0 ] || die "usage: pgf run [options] <caseDir> [Allrun | Allclean | script] [args ...]"
  cd -- "$1" 2>/dev/null || die "case directory not found: $1"
  shift
  pgf_copy_check >&2
  script="${1:-Allrun}"
  [ $# -gt 0 ] && shift
  [[ "$script" == */* ]] || [ ! -f "$script" ] || script="./$script"
  cmd=("$script" "$@")
  if [ "${PGF_CONF_SRC[PGF_YADE]}" = "default" ] && pgf_case_wants_yade .; then
    yade=1
    st INFO "$PWD has an active constant/yadeProperties; using --yade" >&2
  fi
  ;;
esac

if [ "$run_build" -eq 1 ]; then
  [ "$sel" = auto ] || die "--build builds the sources of $(pgf_checkout_name); it cannot be combined with PGF_BUILD=$sel ($sel_src)"
  build_flag=()
  [ "$yade" -eq 1 ] && build_flag=(--yade)
  "$SELF" build "${build_flag[@]}" >&2 || die "pgf build failed"
fi

# -- 2. OpenFOAM ---------------------------------------------------------------

bashrc="${PGF_FOAM_BASHRC:-${WM_PROJECT_DIR:+$WM_PROJECT_DIR/etc/bashrc}}"
[ -n "$bashrc" ] || die "set PGF_FOAM_BASHRC (or WM_PROJECT_DIR) to locate OpenFOAM's etc/bashrc"
[ -r "$bashrc" ] || die "cannot read $bashrc"

PATH="/usr/local/bin:/usr/bin:/bin"
# bashrc parses positional arguments as settings, and fails under -u / -e.
set +eu
set --
# shellcheck disable=SC1090
. "$bashrc"
[ -n "${WM_PROJECT_USER_DIR:-}" ] && [ -n "${WM_OPTIONS:-}" ] ||
  die "$bashrc did not set WM_PROJECT_USER_DIR / WM_OPTIONS"
export PGF_DEFAULT_USER_DIR="${PGF_DEFAULT_USER_DIR:-$WM_PROJECT_USER_DIR}"
export PGF_BUILD_ROOT="${PGF_BUILD_ROOT:-$PGF_DEFAULT_USER_DIR/pgf-builds}"
# pgf copy's home for cases: OpenFOAM's own run dir, from the user dir captured
# above (FOAM_RUN and WM_PROJECT_USER_DIR are pgf's scratch and prefix below).
export PGF_CASE_ROOT="${PGF_CASE_ROOT:-$PGF_DEFAULT_USER_DIR/run}"

# -- 3. the prefix -------------------------------------------------------------

stale=""
if [ "$mode" = tree ] && [ "$sel" != auto ]; then
  prefix="$(python3 "$PGF_LIB/registry.py" resolve "$PGF_BUILD_ROOT" "yade$yade" "$sel" 2>&1)" ||
    die "PGF_BUILD=$sel ($sel_src): $prefix"
  variant="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("variant",""))' "$prefix/.pgf-build.json" 2>/dev/null)"
  if [ "$variant" != "yade$yade" ] && [ "$sel_src" != --prefix ]; then
    [ "${PGF_CONF_SRC[PGF_YADE]}" = cli ] && die "the selected build ${prefix##*/} is $variant, not yade$yade"
    yade="${variant#yade}"
  fi
fi
variant_flag=()
[ "$yade" -eq 1 ] && variant_flag=(--yade)
if [ "$mode" = tree ] && [ "$sel_src" != --prefix ]; then
  auto="$("$PGF_LIB/build.sh" --print-prefix "${variant_flag[@]}")" ||
    die "cannot compute the build key for $PGF_ROOT"
  if [ "$sel" = auto ]; then
    prefix="$auto"
    [ -f "$prefix/.pgf-build.json" ] ||
      die "no complete build of $(pgf_checkout_name) at $prefix; run: $(pgf_self_cmd) build ${variant_flag[*]}"
  elif [ "$prefix" != "$auto" ] && [ "$sel_src" != --prefix ]; then
    stale="the selected build ${prefix##*/} ($sel_src) is not built from the sources of $(pgf_checkout_name) (${auto##*/})"
    if [ "$sub" = run ] && [ "$allow_stale" -eq 0 ]; then
      pgf_stale_refusal "$sel_src" "$prefix" "$auto" "${variant_flag[*]}"
      exit 2
    fi
    st WARN "$stale" >&2
  fi
fi

# -- 4. point the user dirs at it; drop the default user dir from the paths ----

under_default() {
  case "$1" in "$PGF_DEFAULT_USER_DIR" | "$PGF_DEFAULT_USER_DIR"/*) return 0 ;; esac
  return 1
}

strip_default() {
  local IFS=: entry out=()
  for entry in $1; do
    [ -n "$entry" ] && ! under_default "$entry" && out+=("$entry")
  done
  printf '%s' "${out[*]}"
}

PATH="$(strip_default "$PATH")"
LD_LIBRARY_PATH="$(strip_default "${LD_LIBRARY_PATH:-}")"

export PGF_RUN_ROOT="${PGF_RUN_ROOT:-${TMPDIR:-/tmp}/pgf-runs}"
export FOAM_RUN="$PGF_RUN_ROOT"
if [ "$mode" = "bare" ]; then
  unset FOAM_USER_APPBIN FOAM_USER_LIBBIN
  export WM_PROJECT_USER_DIR="$PGF_BUILD_ROOT"
else
  export WM_PROJECT_USER_DIR="$prefix"
  export FOAM_USER_APPBIN="$prefix/bin"
  export FOAM_USER_LIBBIN="$prefix/lib"
  PATH="$PGF_LIB/shims:$FOAM_USER_APPBIN:$PATH" # shims/wmake guards the prefix
  LD_LIBRARY_PATH="$FOAM_USER_LIBBIN${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
export PATH LD_LIBRARY_PATH

# -- 5. run-time settings ------------------------------------------------------

# UCX may print "failed to create VFS socket" on stdout, which RunFunctions'
# getApplication then reads as the application name.
export UCX_VFS_ENABLE=n UCX_LOG_LEVEL=fatal
mkdir -p "$PGF_RUN_ROOT/tmp" || die "cannot create $PGF_RUN_ROOT/tmp"
export TMPDIR="$PGF_RUN_ROOT/tmp"

# -- 6. Yade and MPI -----------------------------------------------------------

if [ "$yade" -eq 1 ]; then
  export YADE_TRUNK="${YADE_TRUNK:-$PGF_ROOT/submodules/Foam-Yade}"
  yade_bin="${YADE_BIN:-$(PATH="$PGF_ENV_CALLER_PATH" command -v yade)}"
fi
# Building (--bare) needs neither the trunk nor the yade binary.
if [ "$yade" -eq 1 ] && { [ "$mode" != bare ] || [ -x "$yade_bin" ]; }; then
  [ -x "$yade_bin" ] || die "no yade binary: set YADE_BIN or put yade on PATH"
  if [ "$mode" != bare ]; then
    checks="$(pgf_yade_check "$yade_bin" "$YADE_TRUNK")" || die "$(grep '^FAIL' <<<"$checks" | cut -c6-)"
    grep '^WARN' <<<"$checks" | while IFS= read -r l; do st WARN "${l#WARN }"; done >&2
  fi
  # Installs may only carry a suffixed binary; the tutorials call plain `yade`.
  shim="$TMPDIR/pgf-bin"
  mkdir -p "$shim" && ln -sfn "$yade_bin" "$shim/yade" || die "cannot create $shim/yade"
  PATH="$shim:$PATH"
  if [ -z "${YADE_PYTHONPATH:-}" ]; then
    for d in "$(dirname "$(dirname "$yade_bin")")"/lib/*/yade-*/py; do
      [ -d "$d" ] && YADE_PYTHONPATH="$d" && break
    done
  fi
  [ -n "${YADE_PYTHONPATH:-}" ] && export PYTHONPATH="$YADE_PYTHONPATH${PYTHONPATH:+:$PYTHONPATH}"

  # Yade hard-codes mkdtemp("/tmp/yade-XXXXXX") and segfaults if /tmp is read-only.
  if [ ! -w /tmp ]; then
    so="$TMPDIR/pgf-mkdtemp-shim.so"
    if [ ! -f "$so" ]; then
      cc -shared -fPIC -O2 -o "$so" "$PGF_LIB/mkdtempShim.c" -ldl ||
        die "cannot build the mkdtemp shim"
    fi
    export LD_PRELOAD="$so${LD_PRELOAD:+:$LD_PRELOAD}"
  fi
  export PATH
fi

mpi_note=""
if [ "$mpi" = "auto" ] && [ -z "${OMPI_MCA_btl_tcp_if_include:-}" ]; then
  why="$(pgf_mpi_auto)" && { mpi="loopback"; mpi_note="because $why"; }
fi
[ "$mpi" = "loopback" ] && [ -z "$mpi_note" ] && mpi_note="PGF_MPI=loopback ($(pgf_layer PGF_MPI))"
if [ "$mpi" = "loopback" ]; then
  export OMPI_MCA_btl=self,vader,tcp OMPI_MCA_btl_tcp_if_include=lo OMPI_MCA_oob_tcp_if_include=lo
fi

# -- 7. assert and announce ----------------------------------------------------

for v in PATH LD_LIBRARY_PATH; do
  IFS=: read -r -a entries <<<"${!v}"
  for entry in "${entries[@]}"; do
    if under_default "$entry"; then
      case "$entry" in "$prefix" | "$prefix"/*) [ "$mode" != "bare" ] && continue ;; esac
      die "$v still holds $entry, under the default user dir $PGF_DEFAULT_USER_DIR"
    fi
  done
done

if [ "$mode" != "bare" ]; then
  solver="$(command -v porousGasificationFoam)"
  case "$solver" in
  "$prefix"/bin/*) ;;
  *) die "porousGasificationFoam resolves to '${solver:-nothing}', not into $prefix/bin" ;;
  esac
  variant="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("variant","?"))' "$prefix/.pgf-build.json" 2>/dev/null)"
  [ "$yade" -eq 1 ] && [ "$variant" != "yade1" ] && die "--yade given, but $prefix is variant $variant"
fi
# What this call uses, in words: OpenFOAM, the build and what chose it, MPI.
# A build needs no MPI, so pgf build leaves it out; so does a serial run
# (no system/decomposeParDict and not DEM), though the setting still applies.
[ -n "${PGF_BANNER_BUILD:-}" ] && mpi_note=""
[ "$sub" = run ] && [ "$yade" -eq 0 ] && [ ! -f system/decomposeParDict ] && mpi_note=""
st INFO "using OpenFOAM $WM_PROJECT_VERSION ($(pgf_tilde "$bashrc"))" >&2
[ -z "${PGF_IMAGE_MANIFEST:-}" ] || st INFO "inside the pgf image $(python3 -c 'import json,sys; m=json.load(open(sys.argv[1]))
print("%s (%s)" % ((m.get("pgf_commit") or "?")[:12], m.get("variant") or "?"))' "$PGF_IMAGE_MANIFEST" 2>/dev/null || echo "($PGF_IMAGE_MANIFEST unreadable)")" >&2
if [ "$mode" != "bare" ]; then
  case "$sel_src" in
  default) why="from the sources of $(pgf_checkout_name)"
    [ -n "${PGF_RUN_FROM_COPY:-}" ] && why="from $(pgf_tilde "$PGF_ROOT"), where the case was copied from" ;;
  --prefix) why="the prefix you gave" ;;
  cli) why="chosen with --use" ;;
  terminal) why="chosen in this terminal with pgf use" ;;
  *) why="PGF_BUILD in $(pgf_tilde "${sel_src#* }")" ;;
  esac
  what="${prefix##*/}" && what="${what%%-*}"
  [ "$sel_src" = --prefix ] && what="$(pgf_tilde "$prefix")"
  case "${variant:-?}" in yade0) kind="non-DEM" ;; yade1) kind="DEM" ;; *) kind="${variant:-?}" ;; esac
  [ "$sel_src" = default ] && why+="; pgf use to change"
  st INFO "using build $what ($kind, $why${stale:+, stale})" >&2
elif [ -z "${PGF_BANNER_BUILD:-}" ]; then # pgf build: build.sh names its destination
  st INFO "using no build (--bare: OpenFOAM only); builds go under $(pgf_tilde "$PGF_BUILD_ROOT")" >&2
fi
[ -z "$mpi_note" ] || st INFO "MPI: local only (lo), $mpi_note" >&2
unset PGF_BANNER_BUILD

# Cases include shared data as "$PGF_ROOT/thermoData/...", so a copied case still finds it.
export PGF_ROOT
export PGF_ENV_ACTIVE=1
unset PGF_ENV_CALLER_PATH

if [ "$sub" = "shell" ] && [ ${#cmd[@]} -eq 0 ]; then
  key="bare"
  [ "$mode" = "bare" ] || key="${prefix##*/}"
  if [ -n "$shell_cmd" ]; then
    cmd=(/bin/bash -c "$shell_cmd")
  else
    rc="$TMPDIR/pgf-shellrc.$$"
    {
      printf 'PS1="(pgf:%s@%s) \\w\\$ "\nrm -f "%s"\n' "${PGF_ROOT##*/}" "$key" "$rc"
      # pgf use changes this terminal's later pgf calls; this shell keeps its build.
      printf 'pgf() { if [ "${1:-}" = use ]; then local l; l="$(%q "$@")" && eval "$l"; else %q "$@"; fi; }\n' "$SELF" "$SELF"
    } >"$rc" || die "cannot write $rc"
    cmd=(/bin/bash --rcfile "$rc" -i)
  fi
fi

# A shared lock for as long as the command runs keeps pgf gc off this build.
if [ "$mode" != "bare" ] && [ -w "${prefix%/*}" ]; then
  exec {use_fd}>"$prefix.use.lock" && flock -s "$use_fd" || die "cannot lock $prefix.use.lock"
fi

# -- 8. run --------------------------------------------------------------------

if [ "$sub" = run ]; then
  # Wait instead of exec so the run record gets the exit status, even on Ctrl-C.
  pgf_run_precheck "${cmd[0]}"
  logs_before="$(pgf_case_logs)"
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)" t0="$(date +%s)"
  trap ':' INT TERM
  "${cmd[@]}"
  rc=$?
  trap - INT TERM
  python3 "$PGF_LIB/registry.py" record "$PWD" "$(pgf_records_dir)" "$prefix" "$sel_src" \
    "${yade_bin:-}" "$([ -n "${yade_bin:-}" ] && pgf_yade_commit "$yade_bin")" "$started" "$rc" "${cmd[@]}" ||
    st WARN "could not write the run record" >&2
  pgf_run_summary "$rc" "$t0" "${cmd[0]}" "$logs_before"
  exit "$rc"
fi
exec "${cmd[@]}"
