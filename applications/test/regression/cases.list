# Tutorials run by the regression framework, one path per non-comment line.
# Paths are relative to the repository root.
# Optional second column: tag (default: fast).
# Optional third column: expectFail or expectLog, then an extended regex (the
# rest of the line). Such a case is judged on its log.* instead of a baseline:
# expectFail needs Allrun to fail and the regex to match; expectLog needs it to
# succeed and the regex to match, or with a leading '!' to match nothing.
#
# Tags:
#   fast        — run by default and by CI on every PR and push to main
#   convergence — mesh-refinement study; run manually with --tag convergence
#                 or --tag all
#
# To add a case:
#   1. Drop tutorials/cases/<caseName>/system/regressionFunctions
#   2. #includeIfPresent it from system/controlDict (functions block)
#   3. Capture a reference/postProcessing/ baseline locally
#   4. Add the path here with an appropriate tag
#
# DEM/Yade cases use a separate runner: applications/test/regression/Allrun.yade
# (they require Yade installed and the solver built with ./build.sh --yade).

# charOnlyMove prescribed-Us fixtures
tutorials/cases/charOnlyMoveCases/serial       fast
tutorials/cases/charOnlyMoveCases/solidInlet          fast
tutorials/cases/charOnlyMoveCases/solidInlet_tinyDt   fast
tutorials/cases/charOnlyMoveCases/solidInlet_ash      fast

# Solid boundary policy (#162): solidInlet_ash with one boundary setting changed
tutorials/cases/charOnlyMoveCases/solidBoundaryPolicy/tsZeroGradient       fast  expectFail  but Ts is zeroGradient
tutorials/cases/charOnlyMoveCases/solidBoundaryPolicy/partialYi            fast  expectFail  solid mass fractions, so the composition
tutorials/cases/charOnlyMoveCases/solidBoundaryPolicy/inheritInflow        fast  expectFail  Solid enters through patch inlet .*which inherits
tutorials/cases/charOnlyMoveCases/solidBoundaryPolicy/inheritInflowWarn    fast  expectLog   which inherits the solid state.* Reported once
tutorials/cases/charOnlyMoveCases/solidBoundaryPolicy/inheritInflowIgnore  fast  expectLog   !Solid enters through patch
tutorials/cases/charOnlyMoveCases/solidBoundaryPolicy/zeroSumInlet         fast  expectFail  sum to zero: fixedSolidH brings enthalpy in
tutorials/cases/charOnlyMoveCases/solidBoundaryPolicy/unnormalisedYi       fast  expectLog   sum to 0.5 .. 0.5; they are normalised to 1
tutorials/cases/charOnlyMoveCases/solidBoundaryPolicy/badPolicy            fast  expectFail  solidBoundaryPolicy maybe is not one of error, warn, ignore
tutorials/cases/charOnlyMoveCases/solidBoundaryPolicy/wallOutflow          fast  expectFail  Solid leaves through wall outlet
tutorials/cases/charOnlyMoveCases/solidBoundaryPolicy/wallInflow           fast  expectFail  Solid enters through wall inlet
tutorials/cases/charOnlyMoveCases/serial_m2    convergence
tutorials/cases/charOnlyMoveCases/serial_m4    convergence

# Canonical fast-tier suite — one small fixture per physics path.
tutorials/cases/canonical/pyrolysis            fast
tutorials/cases/canonical/gasification         fast
tutorials/cases/canonical/radiation            fast
tutorials/cases/canonical/darcy                fast
tutorials/cases/canonical/forchheimer          fast
# pyrolysisE and darcyE: pyrolysis and darcy solved for e instead of h. Their
# Allrun (../solveForE) also fails if e drifts from h's committed reference;
# before #132 the e branch was off by 249 K.
tutorials/cases/canonical/pyrolysisE           fast
tutorials/cases/canonical/darcyE               fast
tutorials/cases/canonical/stoichiometric       fast
tutorials/cases/canonical/enthalpy             fast
tutorials/cases/canonical/meanTemp             fast
tutorials/cases/canonical/noSubintegration     fast
tutorials/cases/canonical/equilibrium          fast

# Conservation fixtures — each asserts an energy integral, not a temperature.
# The regressionHeatTransferResidual baseline is a column of exact zeros: it
# asserts that the solid TEqn and the gas EEqn exchange the same joules, so
# movement there is a conservation failure, never something to recapture.
tutorials/cases/canonical/conservation/interphaseHeatTransfer      fast
tutorials/cases/canonical/conservation/interphaseHeatTransferPlain fast

# radiationReservoir is the only case in the suite with a nonzero bulk
# absorption as, and the only one where the solid's radiative coefficients are
# not identically zero. Its regressionRadiationBookResidual and
# regressionRadiationWallFlux baselines are both columns of exact zeros: the
# walls are zeroGradient on G, so the reservoir is closed and the joules the
# solid TEqn books have to sum to zero on their own. Movement in either is a
# broken radiation book, never something to recapture. The two Booked columns
# are there so the zeros mean something - they say the term is running at
# 1e+07 W/m^3 while the sum stays at roundoff.
tutorials/cases/canonical/conservation/radiationReservoir           fast

# chemistryGateCrossing reacts one cell from connected to dispersed mid-run. Its
# assertions are regressionChemistryHeatOutsideGate,
# regressionGasSourceOutsideGate, regressionInterfaceEnthalpyOutsideGate and
# regressionAgentHeatUpOutsideGate, all columns of exact zeros: no reaction
# heat, no converted mass and no interface enthalpy in a cell whose energy
# equation refuses the heat. regressionPorosityMax is a diagnostic, not an
# assertion - the crossing moves it by only 1e-6 relative, inside rtol.
# regressionGasTempMax is reported, not asserted: in this closed box the
# released gas arrives with h(Ts) (#212 D4), so the gas heats like a rigid
# tank being filled, from 800 K to about 1140 K.
tutorials/cases/canonical/conservation/chemistryGateCrossing        fast

# gatedBandSources starts every cell dispersed, so
# solidConnectedAtStepStart is 0 from t = 0 while solidPresent is still
# 1. Six columns of
# exact zeros - radiationSh, solidChemistrySh, heatTransfer,
# interfaceEnthalpy, agentHeatUp and Srho - say no solid source and no
# interphase term reaches an energy equation there. The liveness columns are what make them mean something:
# volAverage(G) sits at 1e+05 while the solid books nothing from it, and the
# solid holds 900 K above the gas for the whole run without exchanging a
# joule, which at h*SAV = 2000 W/m3/K is 1.8e+06 W/m3 refused.
tutorials/cases/canonical/conservation/gatedBandSources             fast

# interfaceEnthalpy*: one cell with one open face, no interphase exchange,
# hr = 0, no pressure work, ddt Euler. Gas crossing the interface carries the
# enthalpy of the phase it leaves (#212 D4), so the answers are exact: Ts = Tg
# stays put for pyrolysis (Pyrolysis) and gasification (Gasification), and a
# hotter solid gives the hs mixing temperature (Mixing, checked by its Allrun).
# Before D4 the released gas was born at 298 K: Tg fell to 574 K in step 1.
tutorials/cases/canonical/conservation/interfaceEnthalpyPyrolysis     fast
tutorials/cases/canonical/conservation/interfaceEnthalpyMixing        fast
tutorials/cases/canonical/conservation/interfaceEnthalpyGasification  fast

# gasPressureWork is a sealed box at porosity 0.4 whose solid heats the gas, so
# p rises with fixed gas mass. regressionGasEnergyResidual is the gas internal
# energy minus the joules received; it must stay flat. Before #132 it drifted
# by (1 - porosityF)*dp, 180% of the heat received; now it holds within ~1%.
tutorials/cases/canonical/conservation/gasPressureWork              fast

# Prescribed-Us solid-transport suite — Ycharm advection under analytic Us
# fields (asserts the transported Ycharm and the porosityF recovered from it,
# max(porosityF) included so an unbounded void fraction fails the tier).
#
# Seven of the eleven are dilute: the solid never comes close to filling a
# cell, so the solid flux limiter's receiver cap never binds and they assert
# the transport alone. convergingJam, convergingJamTight,
# rightWallSolidAccumulationFromLeftInlet and tetrisCompaction are dense
# variants that drive the bed onto its packing limit, so min(porosityF) sits
# pinned at each case's 1 - maxSolidFraction — that flat value is the assertion that
# solidReceiverLimit() refused a flux rather than the solver aborting.
tutorials/cases/prescribedUsCases/converging         fast
tutorials/cases/prescribedUsCases/convergingJam      fast
tutorials/cases/prescribedUsCases/convergingJamTight fast
tutorials/cases/prescribedUsCases/rightWallSolidAccumulationFromLeftInlet fast
tutorials/cases/prescribedUsCases/tetrisCompaction fast
# tetrisCompactionEmptying is tetrisCompaction with emptyFlippedCells true: the
# fixture for the #31 inflow guard. With the guard off, flips destroy ~4x the
# solid and volIntegrate(Ycharm) fails (#175).
tutorials/cases/prescribedUsCases/tetrisCompactionEmptying fast
tutorials/cases/prescribedUsCases/diverging          fast
tutorials/cases/prescribedUsCases/shear              fast
tutorials/cases/prescribedUsCases/vortexIrrotational fast
tutorials/cases/prescribedUsCases/vortexOneOverR2    fast
tutorials/cases/prescribedUsCases/vortexRankine      fast
tutorials/cases/prescribedUsCases/vortexSolidBody    fast
