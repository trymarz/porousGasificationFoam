#!/bin/bash
# Regression test runner.
# Iterates the case paths listed in cases.list, runs each case, then diffs
# postProcessing/ output against the committed reference/ baseline.
#
# Verified against:
#   gitlab.com/openfoam/core/openfoam : tutorials use Allrun + RunFunctions.
#   gitlab.com/openfoam/core/openfoam/.../FOvolFieldValue : functionObject syntax.

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

# helpers.sh uses an unguarded $HELPERS_SOURCED include guard; disable -u
# around the source so it works under our strict mode.
# shellcheck disable=SC1091
set +u; . "$REPO_ROOT/utilities/bash_utils/helpers.sh"; set -u

CASES_FILE="$SCRIPT_DIR/cases.list"
COMPARE="$SCRIPT_DIR/tools/compareScalars.py"
RUN_CASE="$SCRIPT_DIR/tools/runCase.sh"

RTOL="1e-4"
ATOL="1e-12"
ONLY_CASE=""
SKIP_RUN=false

usage() {
    cat <<EOF
Usage: $0 [options]

Options:
  --case <path>   Run only the named case (must appear in cases.list).
  --rtol <val>    Relative tolerance for compareScalars.py (default 1e-4).
  --atol <val>    Absolute tolerance for compareScalars.py (default 1e-12).
  --no-run        Skip running cases; only compare existing postProcessing/
                  output to reference/.
  -h, --help      Show this help.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --case) ONLY_CASE="$2"; shift 2 ;;
        --rtol) RTOL="$2"; shift 2 ;;
        --atol) ATOL="$2"; shift 2 ;;
        --no-run) SKIP_RUN=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) clog ERROR "Unknown option: $1"; usage; exit 2 ;;
    esac
done

if [ ! -f "$CASES_FILE" ]; then
    clog ERROR "Cases file not found: $CASES_FILE"
    exit 2
fi

# Load cases (strip comments and blank lines).
mapfile -t CASES < <(grep -vE '^\s*(#|$)' "$CASES_FILE")

if [ "${#CASES[@]}" -eq 0 ]; then
    clog WARNING "No cases listed in $CASES_FILE"
    exit 0
fi

# Print run header.
clog INFO "=================================================="
clog INFO "  PGF regression suite"
clog INFO "  cases:   ${#CASES[@]}"
clog INFO "  rtol:    $RTOL   atol: $ATOL"
[ "$SKIP_RUN" = true ] && clog INFO "  mode:    compare only (--no-run)"
[ -n "$ONLY_CASE" ]    && clog INFO "  filter:  $ONLY_CASE"
clog INFO "=================================================="

passed=()
failed=()
skipped=()
pass_times=()
fail_times=()

for caseRel in "${CASES[@]}"; do
    if [ -n "$ONLY_CASE" ] && [ "$(basename "$caseRel")" != "$ONLY_CASE" ] && [ "$caseRel" != "$ONLY_CASE" ]; then
        continue
    fi

    caseDir="$REPO_ROOT/$caseRel"
    caseName="$(basename "$caseRel")"

    clog INFO "--------------------------------------------------"
    clog INFO "  case: $caseName"

    if [ ! -d "$caseDir" ]; then
        clog ERROR "  directory missing: $caseDir"
        failed+=("$caseName (missing dir)")
        fail_times+=("-")
        continue
    fi

    if [ ! -d "$caseDir/reference/postProcessing" ]; then
        clog WARNING "  no reference baseline — skipping"
        clog WARNING "  capture one locally; see README § Regression Testing"
        skipped+=("$caseName")
        continue
    fi

    runFlag=""
    [ "$SKIP_RUN" = true ] && runFlag="--no-run"

    t_start=$(date +%s)
    if "$RUN_CASE" "$caseDir" $runFlag --rtol "$RTOL" --atol "$ATOL" --compare "$COMPARE"; then
        t_elapsed=$(( $(date +%s) - t_start ))
        clog SUCCESS "  PASS  (${t_elapsed}s)"
        passed+=("$caseName")
        pass_times+=("${t_elapsed}s")
    else
        t_elapsed=$(( $(date +%s) - t_start ))
        clog ERROR "  FAIL  (${t_elapsed}s)"
        failed+=("$caseName")
        fail_times+=("${t_elapsed}s")
    fi
done

# Summary table.
total=$(( ${#passed[@]} + ${#failed[@]} + ${#skipped[@]} ))
echo
clog INFO "=================================================="
clog INFO "  regression summary   ($total cases)"
clog INFO "=================================================="

i=0
for c in "${passed[@]}";  do clog SUCCESS "  PASS   ${pass_times[$i]}   $c"; (( i++ )) || true; done
i=0
for c in "${failed[@]}";  do clog ERROR   "  FAIL   ${fail_times[$i]}   $c"; (( i++ )) || true; done
for c in "${skipped[@]}"; do clog SKIP    "  SKIP   -        $c";            done

echo
clog INFO "  passed: ${#passed[@]}   failed: ${#failed[@]}   skipped: ${#skipped[@]}"
clog INFO "=================================================="

if [ "${#failed[@]}" -gt 0 ]; then
    exit 1
fi
exit 0
