#!/bin/sh
# Allwclean: clean this checkout (OpenFOAM convention).
# what:    pgf build clean --all [args]: wclean every target, DEM included
# why:     ./Allwclean is where OpenFOAM users look first; cleaning DEM too means no
#          state from an earlier --yade build survives a switch back
# instead: pgf build clean [targets]; add --purge to drop the installed build
cd "${0%/*}" || exit 1

exec ./pgf build clean --all "$@"
