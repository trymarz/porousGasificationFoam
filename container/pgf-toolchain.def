# pgf-toolchain: a pinned OpenFOAM v2606 toolchain for comparing regression
# baselines against the native build (#120, PR 4; v2606 since #326).
#
# ESI's opencfd/openfoam-run:2606 image (Ubuntu 26.04, system Open MPI, OpenFOAM
# in /usr/lib/openfoam/openfoam2606), pinned by digest, plus openfoam2606-dev
# from ESI's apt repo (already configured in the image) and python3 for the
# comparator. ESI publishes no openfoam-dev:2606 image.
# TODO(#326): openfoam2606-dev is only on apt as release candidate 2606.0~rc2-1.
# Switch FOAM_DEV_VERSION here and in .github/workflows/regression.yml to the
# final package once ESI publishes it.
# PGF itself is not built into the image: pgf test builds the tree it is given
# with pgf build (build.sh --isolated), so one image serves any commit.
# No Yade: the experiment covers the fast and convergence tiers only.
#
# Build (outside the checkout; needs unprivileged user namespaces or root):
#   apptainer build --fakeroot pgf-toolchain.sif container/pgf-toolchain.def
# Use: container/compareToolchains.sh --image pgf-toolchain.sif
# The From: line below is also the image of .github/workflows/regression.yml.

Bootstrap: docker
From: opencfd/openfoam-run@sha256:4229997e74defb81548222d511b8e3b95b98305e5df41b8e88b031813fe47eeb

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    FOAM_DEV_VERSION=2606.0~rc2-1
    apt-get update -q
    apt-get install -y --no-install-recommends --allow-downgrades \
        python3 "openfoam2606-dev=$FOAM_DEV_VERSION"
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    {
        echo "image:    opencfd/openfoam-run:2606 @ sha256:4229997e74de"
        echo "openfoam: $(dpkg-query -W -f='${Version}' openfoam2606-dev) (rc2 until ESI's final package)"
        echo "os:       $(. /etc/os-release && echo "$PRETTY_NAME")"
        echo "gcc:      $(gcc -dumpfullversion)"
        echo "mpi:      $(mpirun --version 2>/dev/null | head -1)"
        echo "python3:  $(python3 --version 2>&1)"
    } > /opt/pgf-toolchain-manifest.txt

%environment
    export PGF_FOAM_BASHRC=/usr/lib/openfoam/openfoam2606/etc/bashrc

%runscript
    exec "$@"

%labels
    OpenFOAM v2606 rc2 (ESI opencfd/openfoam-run:2606 + openfoam2606-dev 2606.0~rc2-1)
    Compiler system gcc (Ubuntu 26.04)
    Manifest /opt/pgf-toolchain-manifest.txt
