#!/bin/bash
# wmake on PATH inside pgf shell/run (#288): the active build's prefix is a cache
# keyed by the sources, so installing into it is refused; edit, then run pgf build.
p="${WM_PROJECT_USER_DIR:-}"
if [ -f "$p/.pgf-build.json" ] && [ "${FOAM_USER_APPBIN:-}" = "$p/bin" ] && [ "${FOAM_USER_LIBBIN:-}" = "$p/lib" ]; then
  case "$PWD $*" in
  */dynamicCode/*) ;; # OpenFOAM's coded functions build into the case, not the prefix
  *)
    echo "pgf: refusing wmake: it would install into the cached build ${p##*/}." >&2
    echo "pgf: after editing the sources, run: pgf build" >&2
    exit 1
    ;;
  esac
fi
exec "${WM_DIR:-$WM_PROJECT_DIR/wmake}/wmake" "$@"
