#!/bin/bash
#
# pgf-env: deprecated alias for pgf (#264), kept for a deprecation period.
#   pgf-env [options] -- CMD   ->  pgf exec [options] -- CMD
#   pgf-env init ...           ->  pgf setup --no-link ...
#   pgf-env install-link ...   ->  pgf setup --link-only ...
#   pgf-env status|doctor|shell|run ...  ->  pgf status|doctor|shell|run ...
# PGF_ENV_QUIET=1 silences the deprecation note.

pgf="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/pgf"
[ -n "${PGF_ENV_QUIET:-}" ] || [ "${PGF_ENV_ACTIVE:-}" = 1 ] ||
  echo "pgf-env: deprecated; use pgf (see pgf --help)" >&2
case "${1:-}" in
status | doctor | shell | run) exec "$pgf" "$@" ;;
init) shift; exec "$pgf" setup --no-link "$@" ;;
install-link) shift; exec "$pgf" setup --link-only "$@" ;;
-h | --help) exec "$pgf" --help ;;
*) exec "$pgf" exec "$@" ;;
esac
