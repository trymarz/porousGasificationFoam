sinclude $(GENERAL_RULES)/mplib$(WM_MPLIB)
sinclude $(RULES)/mplib$(WM_MPLIB)

EXE_INC = \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/sampling/lnInclude \
    -I$(LIB_SRC)/transportModels/compressible/lnInclude \
    -I$(LIB_SRC)/TurbulenceModels/turbulenceModels/lnInclude \
    -I$(LIB_SRC)/TurbulenceModels/compressible/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/specie/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/reactionThermo/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/solidThermo/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/basic/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/chemistryModel/lnInclude \
    -I$(LIB_SRC)/thermophysicalModels/radiation/lnInclude \
    -I$(LIB_SRC)/ODE/lnInclude \
    -I$(LIB_SRC)/combustionModels/lnInclude \
    -I$(LIB_SRC)/Pstream/mpi/lnInclude \
    -I$(FOAM_HGS)/thermophysicalModels/HGSSolidThermo/lnInclude \
    -I$(FOAM_HGS)/pyrolysisModels/lnInclude \
    -I$(FOAM_HGS)/thermophysicalModels/solid/lnInclude \
    -I$(FOAM_HGS)/thermophysicalModels/porousSolidChemistryModel/lnInclude \
    -I$(FOAM_HGS)/radiationModels/lnInclude \
    -I$(FOAM_HGS)/fieldPorosityModel/lnInclude \
    $(PFLAGS) $(PINC)

EXE_LIBS = \
    -lfiniteVolume \
    -lfvOptions \
    -lmeshTools \
    -lsampling \
    -lreactionThermophysicalModels \
    -lspecie \
    -lfluidThermophysicalModels \
    -lchemistryModel \
    -lODE \
    -lcombustionModels \
    -L$(FOAM_USER_LIBBIN) \
    -lHGSradiationModels \
    -lHGSheterogeneousPyrolysisModels \
    -lfieldPorosityModel \
    -lporousSolidChemistryModel \
    -lHGSsolid \
    -lHGSSolidThermo \
    $(PLIBS)

ifeq ($(WITH_YADE),1)
    EXE_INC += \
        -DWITH_YADE=1 \
        -I$(FOAM_HGS)/DEM/lnInclude

    EXE_LIBS += \
        -llambdaDotModel

    /* Which OF-side YADE coupling backend to compile against: foamYade (legacy,
       the default when YADE_COUPLING_LIB is unset, e.g. a raw wmake) or pgfYade
       (the minimal PgfToYadeMpiCoupler backend). Must match how the DEM library
       was built - see porousGasificationMedia/DEM/demCouplingLib.H. */
    ifeq ($(YADE_COUPLING_LIB),pgfYade)
        EXE_INC += \
            -DYADE_COUPLING_PGF=1 \
            -I$(YADE_TRUNK)/pkg/pgfToYadeCoupling/PgfToYadeMpiCoupler/lnInclude

        EXE_LIBS += \
            -lPgfToYadeMpiCoupler
    else
        EXE_INC += \
            -I$(YADE_TRUNK)/pkg/openfoam/coupling/FoamYade/lnInclude

        EXE_LIBS += \
            -lMeshTree \
            -lYadeFoam
    endif
endif
