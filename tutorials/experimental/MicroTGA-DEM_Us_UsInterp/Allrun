#!/bin/sh
cd "${0%/*}" || exit
. "${PGF_ROOT:-../../..}/tutorials/cases/DEM_common/demGuard.sh"   # stop early outside a --yade env (#257)
. "${PGF_ROOT:-../../..}/tutorials/cases/DEM_common/runYade.sh"    # exit with the run's status, not tee's
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
# Requires a Yade-enabled solver build: pgf build --yade

restore0Dir
runApplication blockMesh
runApplication setFields
runApplication decomposePar
mkdir -p spheres springs
# One mpirun starts 2 Yade ranks and the decomposed solver (pgf dem run);
# runYade captures the output to log.yade.
runYade "${PGF_ROOT:-../../..}/pgf" dem run -ndem 2 MPI_lambda.py || exit
