        preconditioner   DIC;
        tolerance        1e-12;
        relTol           1e-7;
    }

}


PIMPLE
{
    momentumPredictor yes;
    nOuterCorrectors  1;
    nCorrectors     2;
    nNonOrthogonalCorrectors 0; // 
}


