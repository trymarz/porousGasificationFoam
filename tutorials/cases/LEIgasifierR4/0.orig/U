FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Inlet mass flows: pure O2, Table 3's primary/secondary split, mapped to the
// slab by R1's planar-2D rule (README.md, "O2 supply").

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    primaryInlet
    {
        type            flowRateInletVelocity;
        massFlowRate    constant 2.5448e-4;  // O2 of Table 3's 30 Nm3/h air
        value           uniform (0 0 0);
    }
    secondaryInlet
    {
        type            flowRateInletVelocity;
        massFlowRate    constant 2.8276e-5;  // O2 of Table 3's 5 Nm3/h air
        value           uniform (0 0 0);
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
    wall
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}

