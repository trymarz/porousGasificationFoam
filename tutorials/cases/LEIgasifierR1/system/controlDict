FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     porousGasificationFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

// Fixed deltaT (inlet Courant ~0.3): Yade runs exactly endTime/dem_dt
// substeps (Allrun). 0.1 s is the coupled smoke run; README.md's
// cold-flow check runs CFD-only to 10 s.
endTime         0.1;

deltaT          4e-3;

maxDeltaT       4e-3;

writeControl    adjustableRunTime;

writeInterval   0.02;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep no;

maxCo      1;

maxDi      5000;

functions
{
    // Gas mass flow through each port; inflow negative.
    portFlow
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        regionType      patch;
        operation       sum;
        fields          (phi);
        writeFields     false;
        name            outlet;
    }
    primaryFlow   { $portFlow; name primaryInlet; }
    secondaryFlow { $portFlow; name secondaryInlet; }

    // Axis probes: chamber bottom, mid chamber, throat, tuyere cone, shaft.
    axisProbes
    {
        type            probes;
        libs            ("libsampling.so");
        writeControl    timeStep;
        writeInterval   1;
        fields          (p U T porosityF Us);
        probeLocations
        (
            (0 0 -0.10)
            (0 0 0.05)
            (0 0 0.20)
            (0 0 0.32)
            (0 0 0.40)
            (0 0 0.60)
            (0 0 0.90)
        );
    }
}

