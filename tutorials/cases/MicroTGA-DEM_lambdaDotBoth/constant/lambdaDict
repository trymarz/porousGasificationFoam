FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      lambdaDict;
}

// Regression fixture: both terms active together -- the configuration a real case would use.
// Valid modes: none, constant, Ts or exactDifferential (the latter reads
// dlambdaOverDTs [m/K] and massSplitBetweenLamAndPor [-], both defaulting to
// 0.0). setFieldsDict seeds the packed-bed box with porosityF < criticalPorosity;
// 0.orig/Ts and 0.orig/T start the whole domain hot (Ts=800, T=850) so both
// the temperature gradient and the pyrolysis chemistry are active from t=0.
lambdaMode exactDifferential;

dlambdaOverDTs 1e-6;

massSplitBetweenLamAndPor 0.5;
