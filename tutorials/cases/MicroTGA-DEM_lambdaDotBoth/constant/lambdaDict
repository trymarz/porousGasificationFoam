FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      lambdaDict;
}

// Regression fixture: both terms active together -- the only fixture testing
// their sum. Temperature is positive (heating), chemistry is negative (mass
// consumed), so the asserted positive sign holds only while temperature
// dominates -- dlambdaOverDYmi below is tuned against that.
// exactDifferential reads dlambdaOverDTs/dlambdaOverDYmi (default 0.0);
// setFieldsDict seeds the packed bed: solid at 650 K, gas at 850 K, walls
// insulated, so the gas heats a slowly pyrolysing bed and both terms are
// active from t=0. Pyrolysis gas stays slow against gas-solid relaxation (#139).
lambdaMode exactDifferential;

// [m/K]. Same value as the Temperature fixture, so the two are comparable:
// it measures as a mean lambdaDot of +5.14e-5 m/s over the 360 solid cells.
dlambdaOverDTs 1e-6;

// [m^4/kg]. Same value as Chemistry (-4.66e-6 m/s there). The terms oppose --
// heating grows lambda, mass loss shrinks it -- and superpose to within ~1%, so
// the sum measures +4.61e-5 m/s: the positive sign asserted here, held by the
// temperature term dominating. Above ~2.8e-5 the chemistry term overtakes it
// and the sign flips.
dlambdaOverDYmi 2.5e-6;
