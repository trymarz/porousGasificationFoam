FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      lambdaDict;
}

// Regression fixture: both terms active together -- the only fixture testing
// their sum. Temperature is positive (heating), chemistry is negative (mass
// consumed), so the asserted positive sign holds only while temperature
// dominates -- dlambdaOverDYmi below is tuned against that.
// exactDifferential reads dlambdaOverDTs/dlambdaOverDYmi/
// splitMassBetweenLamAndPor (default 0.0); setFieldsDict seeds the packed
// bed, domain starts hot (Ts=800, T=850) so both terms are active from t=0.
lambdaMode exactDifferential;

// [m/K]. Same value as the Temperature fixture, so the two are comparable:
// it measures as a mean lambdaDot of +1.70e-3 m/s over the 360 solid cells.
dlambdaOverDTs 1e-6;

// [m^4/kg]. Same value as Chemistry (tuned there to ~-4.3e-4 m/s), so the sum
// measures +1.3e-3 m/s -- negative contribution, positive total, the sign
// asserted here. Above ~1e-5 flips that sign.
dlambdaOverDYmi 2.5e-6;

splitMassBetweenLamAndPor 0.5;
