FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volTensorField;
    location    "0";
    object      Df;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -2 0 0 0 0 0];

internalField   uniform (1e+09 0 0 0 1e+09 0 0 0 1e+09);

boundaryField
{
    wallTop
    {
        type            zeroGradient;
    }
    wallBottom
    {
        type            zeroGradient;
    }
    wallSides
    {
        type            zeroGradient;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform (1e+09 0 0 0 1e+09 0 0 0 1e+09);
    }
}


