FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      lambda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Integrated DEM particle characteristic length scale; 1.0 = unstretched
// spring (YADE convention). Advanced by the solver as lambda += lambdaDot*dt.

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1.0;

boundaryField
{
    ".*"
    {
        type            zeroGradient;
    }
}


