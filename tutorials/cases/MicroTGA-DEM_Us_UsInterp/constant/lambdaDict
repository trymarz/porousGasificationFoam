FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      lambdaDict;
}

// Was implicit before: with no lambdaMode entry the selector defaults to
// constant, and lambdaValue is absent, so lambdaDot = 0. Stated explicitly so
// the case does not silently follow a change of default. Valid modes:
// constant, exactDifferential (the latter reads dlambdaOverDTs [m/K],
// dlambdaOverDYmi [m^4/kg] and splitMassBetweenLamAndPor [-], all defaulting
// to 0.0). This case is about the Us interpolation, so lambdaDot stays 0 and
// YADE's lambda never moves off its 1.0 default.
lambdaMode constant;
