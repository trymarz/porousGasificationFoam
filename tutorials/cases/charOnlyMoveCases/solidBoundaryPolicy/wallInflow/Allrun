#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
# The inlet declared a wall: solid entering through it stops the run.

../copyBase 0.01 || exit
sed -i '/^ *inlet *$/,/}/ s/type patch;/type wall;/' system/blockMeshDict
restore0Dir
runApplication blockMesh
runApplication $(getApplication)
