#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
# As inheritInflow, with solidBoundaryPolicy warn: runs, warns once.

../copyBase 0.01 || exit
for f in Yash Ychar Yhum Yrubberwood; do
    foamDictionary 0.orig/$f -entry boundaryField.inlet.type -set zeroGradient > /dev/null
done
foamDictionary constant/pyrolysisProperties -entry pyrolysisCoeffs.solidBoundaryPolicy -add warn > /dev/null
restore0Dir
runApplication blockMesh
runApplication $(getApplication)
