#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
# Inlet inherits the solid, yet solid enters it: stops the run.

../copyBase 0.01 || exit
for f in Yash Ychar Yhum Yrubberwood; do
    foamDictionary 0.orig/$f -entry boundaryField.inlet.type -set zeroGradient > /dev/null
done
restore0Dir
runApplication blockMesh
runApplication $(getApplication)
