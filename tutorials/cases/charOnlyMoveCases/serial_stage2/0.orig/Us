    {
        //type            fixedValue;
        //value           uniform (0 0 0);
        type            zeroGradient;
    }
    outlet
    {
        //type            fixedValue;
        //value           uniform (0 0 0);
        type            zeroGradient;
    }
    wall
    {
        //type            fixedValue;
        //value           uniform (0 0 0);
        type            zeroGradient;
    }
    axis
    {
        type            zeroGradient;
    }
    back
    {
        type            empty;
    }
    front
    {
        type            empty;
    }
}


