Description
    Writes out values of fields from cells nearest to specified locations.

\*---------------------------------------------------------------------------*/

type            sets;
libs            ("libsampling.so");

writeControl    writeTime;

interpolationScheme cellPoint;

setFormat   raw;

setConfig
{
    type    lineUniform; // lineCell, lineCellFace
    axis    xyz;    // x, y, z, xyz
    nPoints 500;
}

start   (0.02 0. 0.00);
end     (0.02 0. 0.26);

fields  (T Ts Yhum Yrubberwood Ychar1 Ychar Yash O2 H2 CO CO2 H2O CH4 tar porosityF);

sets
(
    line
    {
        $setConfig;
        start $start;
        end   $end;
    }
);

