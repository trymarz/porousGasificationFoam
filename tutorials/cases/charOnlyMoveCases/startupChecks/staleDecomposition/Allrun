#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
# 0/U edited after decomposePar: the 2-rank run stops, asking for decomposePar.

"${PGF_ROOT:-../../../../..}/tutorials/cases/charOnlyMoveCases/solidBoundaryPolicy/copyBase" 0.01 || exit
cat > system/decomposeParDict <<'DICT'
FoamFile { version 2.0; format ascii; class dictionary; object decomposeParDict; }
numberOfSubdomains 2;
method          scotch;
DICT
restore0Dir
runApplication blockMesh
runApplication decomposePar
foamDictionary 0/U -entry boundaryField.inlet.type -set zeroGradient > /dev/null
runParallel $(getApplication)
