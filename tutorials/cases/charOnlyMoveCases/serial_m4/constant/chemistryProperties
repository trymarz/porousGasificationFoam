FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidThermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistry           on;

chemistryType
{
    solver            ode;
}

solidChemistryType
{
    solver              solidOde;
    method              ODESolidHeterogeneousChemistryModel;
    solidThermoType     const<constRad<constThermo<constRho>>>;
}

initialChemicalTimeStep 1e-10;

turbulentReaction   off;
solidReactionEnergyFromEnthalpy false;
stoichiometricReactions false;
showRelativeReactionRates false;
solidChemistryTimeStepControl false;

diffusionLimitedReactions true;

odeCoeffs
{
    solver      seulex;
}

solidOdeCoeffs
{
    solver      seulex;
}

// either this
//species
//(
//   N2 H2O CO O2 H2 CO2 CH4 tar
//);
// or
#include "reactions"

solidReactions
(
//    // Reaction 1
//
//    // Reaction 2
//    irreversibleSolidArrheniusHeterogeneousReaction
//    0.2 rubberwood = 0.2 char
//    (1.38e10 1.9e4 300 3.85e5 1) 
//
//    // Reaction 2
//    irreversibleSolidArrheniusHeterogeneousReaction
//    0.3332 rubberwood = 0.0138 CH4 + 0.0459 H2O + 0.2735 tar
//    (1.38e10 1.9e4 300 3.85e5 1) 
//
//        // Reaction 2
//    irreversibleSolidArrheniusHeterogeneousReaction
//    0.4668 rubberwood = 0.0232 H2 + 0.1695 CO + 0.2741 CO2
//    (1.38e10 1.9e4 300 3.85e5 1)

    // Reaction 3
    // #201: A/2.33 and hr*2.33 (were 5.61e9, -3.95e6) keep the kinetics this case
    // had when every coefficient was divided by all 2.33 kg of reactants.
    irreversibleSolidArrheniusHeterogeneousReaction
    char + 1.33 O2 = 2.33 CO
    (2.40772532e+09 1.96e4 300 -9203500 1 1)

    // Reaction 4
    // #201: A/3.66 and hr*3.66 (were 5.61e9, -8.94e6) keep the kinetics this case
    // had when every coefficient was divided by all 3.66 kg of reactants.
    irreversibleSolidArrheniusHeterogeneousReaction
    char + 2.66 O2 = 3.66 CO2
    (1.53278689e+09 1.96e4 300 -32720400 1 1)

//    // Reaction 5
//    irreversibleSolidArrheniusHeterogeneousReaction
//    char + 0.33 H2 = 1.33 CH4
//    (4.189 2.31e3 300 -4.66e6 1 1)

    // Reaction 6
    // #201: A/4.66 and hr*4.66 (were 3.616e4, 3.07e6) keep the kinetics this case
    // had when every coefficient was divided by all 4.66 kg of reactants.
    irreversibleSolidArrheniusHeterogeneousReaction
    char + 3.66 CO2 = 4.66 CO
    (7759.65665 9308.39 300 14306200 1 1)

//    // Reaction 7
//    irreversibleSolidArrheniusHeterogeneousReaction
//    char + 1.5 H2O = 2.33 CO + 0.17 H2 
//    (1.517e7 1.46e4 300 4.38e6 1 1)

);

