#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
# Requires a Yade-enabled solver build: ./build.sh --yade

restore0Dir
runApplication blockMesh
runApplication topoSet
runApplication setFields
runApplication decomposePar
mkdir -p spheres springs
# Solver runs inside Yade via the MPI coupling script — not a standard runParallel,
# so it is launched directly here (output captured to log.yade).
mpirun --allow-run-as-root -n 2 yade MPI_lambda.py 2>&1 | tee log.yade

# Case-specific assertion: lambdaDot is the dimensionless factor r > 0. Per step
# r is ~1-4e-9, below writePrecision, so shrinkage is checked on lambda instead
# (started at 1, must end below 1).
python3 ../../../applications/test/regression/tools/checkFieldSign.py . \
    --dims lambdaDot="0 0 0 0 0 0 0" \
    --dims lambda="0 1 0 0 0 0 0" \
    --sign lambdaDot=positive \
    --mean-below lambda=1
