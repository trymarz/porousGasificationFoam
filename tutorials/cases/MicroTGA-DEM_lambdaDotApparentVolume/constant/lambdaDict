FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      lambdaDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Regression fixture for lambdaMode apparentVolume: lambdaDot is the
// dimensionless factor r = cbrt(1 + dV_chem/V_old) that Yade multiplies each
// particle's lambda by once per exchange. With the Corymbia entries
// (rhoApparent 583 wood and char1, 459 char), wood -> targas and char1 ->
// 0.65 char both lose apparent volume, so r < 1 wherever the solid reacts.
// Requires Foam-Yade with the lambda factor mode handshake (d5c33e0).
lambdaMode apparentVolume;

// Optional guards, shown at their defaults.
minSolidVolume  1e-6;   // [-] V_old below this: r = 1
minVolumeRatio  1e-6;   // [-] floor on 1 + dV_chem/V_old

