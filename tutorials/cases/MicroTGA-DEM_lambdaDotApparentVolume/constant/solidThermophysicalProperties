FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidThermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType solidMixtureThermo<constHeterogeneous>;

#include "../../../../thermoData/solidThermoData"

// The shared reactions (wood -> targas, wood -> char1 -> 0.65 char).
// lambdaMode apparentVolume needs rhoApparent for every specie; the Park
// entries assume no shrinkage and would give r = 1.
solidComponents
(
    wood char1 char
);

woodCoeffs { $corymbiaWood; }

// Park treats the intermediate solid like wood, volume included.
char1Coeffs { $corymbiaWood; }

charCoeffs { $corymbiaChar; }

