#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

# Requires a Yade-enabled solver build:  ./build.sh build --yade
# (a plain porousGasificationFoam binary will NOT run this case correctly —
#  Yade is the MPI parent and spawns the OpenFOAM ranks itself).

rm -rf 0
cp -r 0.orig 0

runApplication blockMesh
runApplication setFields
runApplication setExprFields
# Single-proc — no domain decomposition needed

mkdir -p spheres

# Pre-compaction: settle the bed under gravity in a standalone single-process
# (non-MPI) Yade run, so the coupled run starts at rest instead of free-falling
# from the grid pack. compact.py writes compact_positions.txt, which
# MPI_lambda.py loads if present (otherwise it falls back to the grid pack).
echo "=== Pre-compacting bed (Yade only, no coupling) ==="
yade compact.py 2>&1 | tee log.compact
[ -f compact_positions.txt ] || { echo "ERROR: compact_positions.txt not generated!" >&2; exit 1; }

# Single-proc: Yade + 1 OpenFOAM rank (numProcOF=1 in MPI_lambda.py).
# No mpirun — yade launches directly and spawns the single OF rank internally.
echo "=== Starting coupled CFD-DEM (single-proc) ==="
yade MPI_lambda.py 2>&1 | tee log.yade
