FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidUsPotentialDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// Inputs to the solidUsPotential utility (see
// lei-gasifier-continuity-us-field-2026-09-14.md). It solves a Poisson
// equation for a solid mass-flux potential Phi, sinks mass in three
// reaction zones, and writes the resulting non-uniform Us to 0.orig/Us.
//
// inletMassFlux derivation (reproduces today's -4.4e-4 m/s throughput
// exactly, only redistributing how it varies through the domain):
//   inlet area   A     = 0.40 m (full top width, blocks 4+5+6) * 0.016 m
//                       = 0.0064 m^2
//   inlet solid true density rhoSolidInlet = rho_wood = 1050 kg/m^3
//   (setFieldsDict's bed region is dry wood, Ywood = 1)
//   inletMassFlux = rhoSolidInlet * (1 - porosityInlet) * |Us_ref| * A
//                 = 1050 * 0.60 * 4.4e-4 * 0.0064 = 1.77408e-3 kg/s
//
// Per-zone sink masses (kg/s), sized to ~90% overall gas conversion
// (Decision 4); the remaining 10% of inletMassFlux is the unconverted
// residue that reaches the outlet:
//   gasYield   = 1 - 0.0074  [R24 char/gas split]          = 0.9926
//   fPyro      = 0.90  (fraction of the wood reacted in the pyrolysis zone)
//   sink(pyrolysis)    = fPyro*inletMassFlux*gasYield      = 1.58486e-3 kg/s
//   freshChar          = fPyro*inletMassFlux*(1-gasYield)  = 1.1815e-5 kg/s
//     assumed fully burned out downstream (100% char burnout), split
//     80/20 combustion/gasification (oxidation dominates char removal;
//     Boudouard accounts for the rest reaching the reduction zone --
//     an assumption, flagged, not measured):
//   sink(combustion)   = 0.80 * freshChar                  = 9.4523e-6 kg/s
//   sink(gasification) = 0.20 * freshChar                  = 2.3631e-6 kg/s
//
// Zone z-ranges taken directly from system/make_mesh.py's block comments
// (Decision 3): block 3 (0.32-0.42, expansion) carries no sink.

inletMassFlux   1.77408e-3;   // kg/s, solid mass entering at z = 1.00

zones
{
    pyrolysis
    {
        zMin            0.42;
        zMax            1.00;
        sinkMassRate    1.58486e-3;   // kg/s
    }
    combustion
    {
        zMin            0.20;
        zMax            0.32;
        sinkMassRate    9.4523e-6;    // kg/s
    }
    gasification
    {
        zMin            0.00;
        zMax            0.20;
        sinkMassRate    2.3631e-6;    // kg/s
    }
}

