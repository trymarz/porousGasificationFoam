FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      lambdaDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// lambdaDot is the particle radius change rate per time step.
// When Yade is active, per-particle lambdaDot is set by FoamCoupling directly.
// This dictionary provides the fallback fluid-side expression (unused when Yade
// overwrites the field, but the solver requires the file to be present).

lambdaDot
{
    type coded;
    code
    #{
        return 1.0;
    #};
}

