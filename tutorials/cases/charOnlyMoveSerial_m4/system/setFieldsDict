FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue Ts -1
    volScalarFieldValue porosityF  1. 
    volScalarFieldValue porosityF0 1.
    volScalarFieldValue Yrubberwood  0.
    volScalarFieldValue Ychar   1.  
    volScalarFieldValue Yhum  0.
    volScalarFieldValue Yash  0.
);

regions
(
    // Char blob: a band of solid material that the prescribed Us advects in +x.
    boxToCell
    {
        box (0.003 -0.1 0.003) (0.006 0.1 0.007);
        fieldValues
        (
            volScalarFieldValue Ychar      0.9
            volScalarFieldValue Yash        0.1
            volScalarFieldValue porosityF   0.99
            volScalarFieldValue porosityF0  0.99
            volScalarFieldValue Ts          600
        );
    }

    // Prescribed solid velocity over the band the blob occupies (no Yade here).
    boxToCell
    {
        box (0.0 -0.1 0.003) (0.02 0.1 0.007);
        fieldValues
        (
            volVectorFieldValue Us (0.01 0 0)
        );
    }
);

