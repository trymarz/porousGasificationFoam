#!/bin/sh

# 1. Generate blockMeshDict from the classy_blocks mesh script
#    Requires classy_blocks in the py_utils venv (run `uv sync` once in
#    utilities/py_utils/ to set it up).
VENV="$(dirname "$(realpath "$0")")/../../utilities/py_utils/.venv"
if [ -d "$VENV" ]; then
    "$VENV/bin/python3" system/make_mesh.py
else
    # Fallback: use whatever python3 is on PATH (must have classy_blocks)
    python3 system/make_mesh.py
fi

# 2. Build the mesh and initialise fields
cp -r 0_orig 0
blockMesh
setFields

# 3. Decompose for parallel run (2 ranks, split in X direction)
decomposePar

# 4. Launch coupled Yade+OpenFOAM run
mpirun -n 2 yade MPI_lambda.py
