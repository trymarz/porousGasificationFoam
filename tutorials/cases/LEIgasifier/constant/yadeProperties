
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      yadeProperties;
}

// YADE-OpenFOAM coupling properties

// Set to true only when launching via `mpirun -n 2 yade MPI_lambda.py`
// (Yade process must be the MPI parent; OpenFOAM connects as child).
// With CFD-only runs (porousGasificationFoam -parallel), keep false to
// avoid MPI_Intercomm_merge failing with no Yade co-process present.
active          false;

nu              1.8e-5;    // air kinematic viscosity at ~300 K (m2/s)

partDensity     1050;      // wood / char density (kg/m3)

fluidDensity    0.6;       // approx. air at 800 K (kg/m3)
