FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Default: gas-only (freeboard and any unset region)
defaultFieldValues
(
    volScalarFieldValue Ts             300
    volScalarFieldValue porosityF      1.0
    volScalarFieldValue porosityF0     1.0
    volScalarFieldValue Ywood          0.0
    volScalarFieldValue Ychar          0.0
    volScalarFieldValue Yhum           0.0
    volScalarFieldValue Yash           0.0
);

regions
(
    // Fresh moist biomass fills the entire bed above the freeboard.
    // Moisture content 18.5 wt% (Jayah et al., as in Ibrahim 2025).
    // Porosity 0.40 — representative for wood chips/pellets in a packed bed.
    // All material cold (300 K). Hot air entering from the top (inlet at 1100 K)
    // provides the sole ignition source: drying propagates downward, then pyrolysis,
    // then char oxidation at the combustion zone.
    boxToCell
    {
        box (-0.21 -0.1 0.20) (0.21 0.1 1.01);
        fieldValues
        (
            volScalarFieldValue Ywood          0.815
            volScalarFieldValue Yhum           0.185
            volScalarFieldValue Ychar          0.0
            volScalarFieldValue Yash           0.0
            volScalarFieldValue porosityF      0.40
            volScalarFieldValue porosityF0     0.40
            volScalarFieldValue Ts             300
        );
    }
);

