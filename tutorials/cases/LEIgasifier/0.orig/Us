FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Us;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

// Bed descent rate. 4.4e-4 m/s is what a real 0.16 m-throat Imbert running at
// ~20 kg/h works out to once scaled onto this 16 mm-deep 2D slab; the 0.01 m/s
// this case used to carry is a ~23x faster throughput than the geometry can be
// supplied with air for, and gives the solid a ~100 s residence time.
internalField   uniform (0 0 -4.4e-4);

boundaryField
{
    outlet
    {
        type            zeroGradient;
    }
    inlet
    {
        type            zeroGradient;
    }
    wall
    {
        type            zeroGradient;
    }
    nozzle
    {
        type            zeroGradient;
    }
    sides
    {
        type            empty;
    }
}


