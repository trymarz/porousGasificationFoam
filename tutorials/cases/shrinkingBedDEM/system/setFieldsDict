FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Default: gas-only (freeboard and any unset region), ambient.
defaultFieldValues
(
    volScalarFieldValue Ts             600
    volScalarFieldValue T              600
    volScalarFieldValue porosityF      1.0
    volScalarFieldValue porosityF0     1.0
    volScalarFieldValue Ywood          0.0
    volScalarFieldValue Yinert         0.0
);

// Regions apply in order; a later one overrides an earlier one cell by cell.
regions
(
    // Inert bed, z 0-0.36 m, porosity 0.4: carries the spheres, never reacts.
    boxToCell
    {
        box (-0.11 -0.1 0.0) (0.11 0.1 0.36);
        fieldValues
        (
            volScalarFieldValue Yinert         1.0
            volScalarFieldValue porosityF      0.40
            volScalarFieldValue porosityF0     0.40
        );
    }
    // Reactive layer, z 0.10-0.16 m: wood devolatilises to tar and vanishes,
    // so the bed above it descends and the bed below stays put.
    boxToCell
    {
        box (-0.11 -0.1 0.10) (0.11 0.1 0.16);
        fieldValues
        (
            volScalarFieldValue Ywood          1.0
            volScalarFieldValue Yinert         0.0
        );
    }
);

