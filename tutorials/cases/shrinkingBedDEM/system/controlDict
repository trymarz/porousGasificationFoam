FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     porousGasificationFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

// Fixed deltaT (issue #104): Yade must run exactly endTime/yadeDt substeps;
// Allrun derives YADE_NSTEPS from this endTime (yadeDt = dem_dt in
// demGeometry.py). At k = 0.1 1/s the reactive layer's spheres halve in
// radius by ~21 s and fall below the 0.1 mm erase radius after ~110 s.
endTime         120;

deltaT          4e-3;

maxDeltaT       4e-3;

writeControl    adjustableRunTime;

writeInterval   5;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  no;

maxCo           1;

maxDi           5000;

functions
{
    // Solid inventory: wood falls with the reaction, inert is conserved.
    solidMass
    {
        type            volFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    adjustableRunTime;
        writeInterval   1;
        operation       volIntegrate;
        regionType      all;
        writeFields     false;
        fields          (Ywood Yinert);
    }

    // Bed descent and sphere shrinkage on the column axis.
    axisProbes
    {
        type            probes;
        libs            ("libsampling.so");
        writeControl    adjustableRunTime;
        writeInterval   1;
        fields          (porosityF Ywood Yinert Us lambda nParticles);
        probeLocations
        (
            (0.01 0 0.05)
            (0.01 0 0.13)
            (0.01 0 0.20)
            (0.01 0 0.30)
            (0.01 0 0.35)
        );
    }
}

