// One block on purpose: Yade's ymport.blockMeshDict reads this file too, and
// its parser needs every "(" / ")" of a list on a line of its own.
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
