#!/bin/sh
cd "${0%/*}" || exit
. "${PGF_ROOT:-../../..}/tutorials/cases/DEM_common/demGuard.sh"   # stop early outside a --yade env (#257)
. "${PGF_ROOT:-../../..}/tutorials/cases/DEM_common/runYade.sh"    # exit with the run's status, not tee's
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
# Requires a Yade-enabled solver build: pgf build --yade

restore0Dir
runApplication blockMesh
runApplication topoSet
runApplication setFields
runApplication decomposePar
mkdir -p spheres springs
# One mpirun starts 2 Yade ranks and the decomposed solver (DEM_common/pgfDemRun);
# runYade captures the output to log.yade.
runYade "${PGF_ROOT:-../../..}/tutorials/cases/DEM_common/pgfDemRun" -ndem 2 MPI_lambda.py || exit

# Direction: r > 0 here, r <= 1 and max(lambda) <= 1 in system/regressionInvariants,
# and the mean lambda (started at 1) must end below 1 as the char gasifies.
python3 "${PGF_ROOT:-../../..}/applications/test/regression/tools/checkFieldSign.py" . \
    --dims lambdaDot="0 0 0 0 0 0 0" \
    --dims lambda="0 1 0 0 0 0 0" \
    --sign lambdaDot=positive \
    --mean-below lambda=1
