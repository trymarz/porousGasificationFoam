#!/bin/sh
# pgfDemRun — start a coupled Yade + porousGasificationFoam run with one mpirun
# (coupling v2, PgfDemBridge, #328). Run it from the case directory:
#
#   pgfDemRun [-ndem N] [-nfoam M] [-solver NAME] SCRIPT.py [yade args ...]
#
#   -ndem N     Yade ranks, mpy's master included (default 2)
#   -nfoam M    OpenFOAM ranks (default: numberOfSubdomains in
#               system/decomposeParDict); the case must be decomposed into M
#               processor* directories, one (processor0) when M is 1
#   -solver     the solver (default porousGasificationFoam)
#
# It runs one mpirun of N+M copies of itself; ranks below N exec
# `yade SCRIPT.py`, the others `SOLVER -parallel -mpi-split-by-appnum
# -mpi-threads`. One app, not `A : B`: Open MPI 5.0.7 segfaults on that (#328).
# PGF_MPIRUN_FLAGS adds mpirun options. POSIX sh.

self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

pgfDemRun_die() {
    echo "pgfDemRun: $1" >&2
    exit 2
}

# Per-rank role switch: pgfDemRun --role NDEM SOLVER yade SCRIPT.py [args ...]
if [ "${1:-}" = --role ]; then
    ndem="$2" solver="$3"
    shift 3
    rank="${OMPI_COMM_WORLD_RANK:-${PMIX_RANK:-${PMI_RANK:-${SLURM_PROCID:-}}}}"
    [ -n "$rank" ] || pgfDemRun_die "cannot find this process's MPI rank (no OMPI_COMM_WORLD_RANK, PMIX_RANK, PMI_RANK or SLURM_PROCID)"
    [ "$rank" -lt "$ndem" ] && exec "$@"
    exec "$solver" -parallel -mpi-split-by-appnum -mpi-threads
fi

ndem=2 nfoam="" solver=porousGasificationFoam
while [ $# -gt 0 ]; do
    case "$1" in
        -ndem) ndem="${2:?-ndem needs a number}"; shift 2 ;;
        -nfoam) nfoam="${2:?-nfoam needs a number}"; shift 2 ;;
        -solver) solver="${2:?-solver needs a name}"; shift 2 ;;
        -h|-help|--help) sed -n '2,16p' "$self" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) pgfDemRun_die "unknown option $1 (see pgfDemRun -help)" ;;
        *) break ;;
    esac
done
[ $# -ge 1 ] || pgfDemRun_die "no Yade script given (see pgfDemRun -help)"
[ -f "$1" ] || pgfDemRun_die "Yade script $1 not found in $PWD"

if [ -z "$nfoam" ]; then
    [ -f system/decomposeParDict ] || pgfDemRun_die "no system/decomposeParDict: give -nfoam"
    nfoam="$(foamDictionary -entry numberOfSubdomains -value system/decomposeParDict 2>/dev/null)" ||
        pgfDemRun_die "cannot read numberOfSubdomains from system/decomposeParDict"
fi
case "$ndem$nfoam" in *[!0-9]*) pgfDemRun_die "-ndem and -nfoam must be whole numbers (got $ndem, $nfoam)" ;; esac
[ "$ndem" -ge 1 ] && [ "$nfoam" -ge 1 ] || pgfDemRun_die "-ndem and -nfoam must be at least 1"
# The solver always runs -parallel, so even one OpenFOAM rank reads processor0 (#328 D4).
[ -d "processor$((nfoam - 1))" ] && [ ! -d "processor$nfoam" ] ||
    pgfDemRun_die "the case is not decomposed into $nfoam processor* directories (run decomposePar, numberOfSubdomains $nfoam)"

flags=""
if mpirun --version 2>&1 | grep -q "Open MPI\|OpenRTE"; then
    flags="--oversubscribe"
    [ "$(id -u)" = 0 ] && flags="$flags --allow-run-as-root"
fi
np=$((ndem + nfoam))
echo "pgfDemRun: $ndem Yade + $nfoam OpenFOAM rank(s): mpirun -np $np $flags ${PGF_MPIRUN_FLAGS:-}"
# shellcheck disable=SC2086 # the flags are words
exec mpirun $flags ${PGF_MPIRUN_FLAGS:-} -np "$np" "$self" --role "$ndem" "$solver" yade "$@"
