FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      pyrolysisProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

active          true; 

heterogeneousPyrolysisModel  volPyrolysis; // Volumetric solid pyrolysis model used for porosity, solid species, solid temperature, and gas source coupling.

pyrolysisCoeffs
{
    subintegrateHeatTransfer true; // Uses smaller internal steps for gas-solid heat transfer; improves stability when heat exchange is stiff.
    bedCollapse false; // Enables the old continuum bed-collapse route model. Keep false when DEM cell-to-cell solid transfer is used.
    advectSolidFields true; // Enables Eulerian advection of porosity, Ys, rho, and T by Us. When false, solid follows spheres position only. when true, solid follows velocity (Us)
    replenish false; // If true, bedCollapse can refill emptied cells with feedstock; false leaves emptied donor cells as gas.

    // Solid regimes, by solid volume fraction alpha = 1 - porosityF.
    // Each threshold ends the regime below it:
    // empty (alpha = 0) | trace | dispersed | connected | maxSolidFraction
    solidRegimes
    {
        dispersedAboveSolidFraction  1e-8;    // below: trace, Ts follows the gas
        connectedAboveSolidFraction  0.0001;  // below: dispersed, no solid sources, may be emptied
        maxSolidFraction             0.9999;  // connected up to here; never exceeded
        dispersedSolidTemperature    solid;   // solid | gas
    }
}

infoOutput      true; // Prints integrated pyrolysis diagnostics such as gas produced, solid lost, and heat release.

// Motion option guide:
// - YADE with DEM cell-to-cell solid transfer:
//     bedCollapse false; advectSolidFields false; replenish false;
//     DEM particle moves directly copy solid state between cells.


// - Prescribed or constant Us without YADE:
//     bedCollapse false; advectSolidFields true; replenish false;
//     Porosity, solid species, density, and temperature move by Eulerian Us advection.



// - active true runs pyrolysis/solid evolution; active false is useful for DEM-only motion tests.
// - infoOutput true prints diagnostics; false keeps the log quieter.

// ************************************************************************* //
