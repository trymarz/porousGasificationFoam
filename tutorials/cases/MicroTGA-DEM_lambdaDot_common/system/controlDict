FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     porousGasificationFoam;

startFrom       startTime;

startTime       0; 

stopAt          endTime;

// Short: fixture only needs enough coupling steps past the first
// (zeroed) exactDifferential call to sample a settled lambdaDot value.
endTime         0.002;

deltaT          1e-6;

writeControl    adjustableRunTime;

writeInterval   0.0002;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep no;

maxCo       0.5; 

maxDi       5000;

maxDeltaT	0.05;

functions
{
    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          ("p,U,Ts");
    }

    solidBedFieldValueBase
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        regionType      cellZone;
        name            solidBed;
        postOperation   none;
        weightField     none;
        writeFields     false;
        writePrecision  10;
        writeToFile     true;
        log             false;
        enabled         false;      // template; children override
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
        writeInterval   -1;
    }

    // lambda - 1 for the lambdaMinusOne* metrics below (must precede them).
    // Cells set by the background value (AltInterp: |lambda - 1| ~ 0.5) are
    // zeroed, else that O(1) offset would hide the 1e-8..1e-6 signal again.
    lambdaMinusOne
    {
        type            exprField;
        libs            (fieldFunctionObjects);
        field           lambdaMinusOne;
        expression      "(mag(lambda - 1) < 0.01) ? lambda - 1 : 0";
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
    }

    lambdaDotAverage
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambdaDot);
        operation       average;
    }

    lambdaDotMin
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambdaDot);
        operation       min;
    }

    lambdaDotMax
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambdaDot);
        operation       max;
    }

    lambdaAverage
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambda);
        operation       average;
    }

    lambdaMin
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambda);
        operation       min;
    }

    lambdaMax
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambda);
        operation       max;
    }

    // lambda* compare lambda ~ 1 at the default rtol 1e-4, which accepts any
    // lambda in [0.9999, 1.0001]; lambda moves by 1e-8..1e-5 here (#194).
    // Kept: they still catch an O(1) change, e.g. in AltInterp's background.

    // lambda - 1 is the signal itself, so the default rtol 1e-4 bounds its
    // relative change (a 10% rate change fails it); atol 1e-12 only matters
    // where it is exactly 0 (Min/Max over cells lambdaDot never reaches).
    lambdaMinusOneAverage
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambdaMinusOne);
        operation       average;
    }

    lambdaMinusOneMin
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambdaMinusOne);
        operation       min;
    }

    lambdaMinusOneMax
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambdaMinusOne);
        operation       max;
    }

    #includeFunc probes
}

// ************************************************************************* //
