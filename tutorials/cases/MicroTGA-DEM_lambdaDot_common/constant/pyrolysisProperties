FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      pyrolysisProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

active          true;

heterogeneousPyrolysisModel  volPyrolysis;

pyrolysisCoeffs
{
    subintegrateHeatTransfer true;

    // Required by the DEM coupling: lambdaDot is switched off in cells whose
    // porosity has reached this value, as they hold too little solid to carry
    // the sphere skeleton.
    criticalPorosity 0.9999;
}

infoOutput      true;

