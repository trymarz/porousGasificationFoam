#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
restore0Dir
runApplication blockMesh
runApplication $(getApplication)
# The check writes log.radiationGasSlab, which the fast tier's expectLog greps.
L=log.radiationGasSlab
python3 slabCheck.py > $L 2>&1 || { cat $L >&2; exit 1; }
echo "radiationGasSlab: PASS" >> $L
cat $L
