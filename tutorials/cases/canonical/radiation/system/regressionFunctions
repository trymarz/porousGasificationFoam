regressionBase
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      all;
    postOperation   none;
    weightField     none;
    writeFields     false;
    writePrecision  10;
    writeToFile     true;
    log             false;
    enabled         false;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   -1;
}

regressionTsAverage
{
    ${regressionBase}
    enabled         true;
    fields          (Ts);
    operation       volAverage;
}

regressionTsMax
{
    ${regressionBase}
    enabled         true;
    fields          (Ts);
    operation       max;
}

regressionGAverage
{
    ${regressionBase}
    enabled         true;
    fields          (G);
    operation       volAverage;
}

regressionPorosityAverage
{
    ${regressionBase}
    enabled         true;
    fields          (porosityF);
    operation       volAverage;
}

// Wood mass [kg]: Ywood is 1 in a one-component solid, so its integral was
// the mesh volume (#69); Ywoodm, the partial density, falls as wood pyrolyses.
regressionWoodIntegral
{
    ${regressionBase}
    enabled         true;
    fields          (Ywoodm);
    operation       volIntegrate;
}

