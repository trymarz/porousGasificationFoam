regressionBase
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      all;
    postOperation   none;
    weightField     none;
    writeFields     false;
    writePrecision  10;
    writeToFile     true;
    log             false;
    enabled         false;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   -1;
}

regressionTsAverage
{
    ${regressionBase}
    enabled         true;
    fields          (Ts);
    operation       volAverage;
}

regressionPorosityAverage
{
    ${regressionBase}
    enabled         true;
    fields          (porosityF);
    operation       volAverage;
}

regressionCharIntegral
{
    ${regressionBase}
    enabled         true;
    fields          (Ychar);
    operation       volIntegrate;
}

regressionCOAverage
{
    ${regressionBase}
    enabled         true;
    fields          (CO);
    operation       volAverage;
}

regressionCO2Average
{
    ${regressionBase}
    enabled         true;
    fields          (CO2);
    operation       volAverage;
}

regressionO2Average
{
    ${regressionBase}
    enabled         true;
    fields          (O2);
    operation       volAverage;
}

// Gas temperature: the exothermic CO oxidation is the only thing that moves it
// off 1000 K besides the solid, so it is the check that the heat of the gas
// reaction reaches the gas energy equation.
regressionTAverage
{
    ${regressionBase}
    enabled         true;
    fields          (T);
    operation       volAverage;
}

