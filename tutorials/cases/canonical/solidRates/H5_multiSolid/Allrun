#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
# Two solid reactants and a gas reactant.
python3 ../solidRates.py setup gasification --reaction '0.5 char + 0.5 ash + O2 = 2 CO' --coeffs '5.61e9 1.96e4 300 -3.95e6 1 1 1' --set Ychar=0.5 Yash=0.5 || exit
restore0Dir
runApplication blockMesh || exit
runApplication $(getApplication) || exit
python3 ../solidRates.py check > log.solidRates 2>&1 || { cat log.solidRates >&2; exit 1; }
