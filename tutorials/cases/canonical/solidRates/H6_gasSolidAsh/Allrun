#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
# Solid + gas to ash + gas, the paper's Sec. 5.6 gasifier shape.
python3 ../solidRates.py setup gasification --reaction 'char + 1.25 O2 = 0.5 ash + 1.75 CO' --coeffs '5.61e9 1.96e4 300 -6.22e6 1 1' --set Ychar=1 Yash=0 || exit
restore0Dir
runApplication blockMesh || exit
runApplication $(getApplication) || exit
python3 ../solidRates.py check > log.solidRates 2>&1 || { cat log.solidRates >&2; exit 1; }
