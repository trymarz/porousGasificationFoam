#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
# Solid to solid + gas, no gas reactant.
python3 ../solidRates.py setup gasification --reaction 'char = 0.65 ash + 0.35 CO' --coeffs '1e3 1.0e4 300 -2.1e5 1' --dt 1e-6 --set Ychar=1 Yash=0 || exit
restore0Dir
runApplication blockMesh || exit
runApplication $(getApplication) || exit
python3 ../solidRates.py check > log.solidRates 2>&1 || { cat log.solidRates >&2; exit 1; }
