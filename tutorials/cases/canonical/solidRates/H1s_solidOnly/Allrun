#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
# H1_solidOnly in stoichiometric mode.
python3 ../solidRates.py setup pyrolysis --reaction 'wood = targas' --coeffs '10 2000 300 1e4 1' --dt 1e-6 --set Ts=600 T=600 --stoichiometric || exit
restore0Dir
runApplication blockMesh || exit
runApplication $(getApplication) || exit
python3 ../solidRates.py check > log.solidRates 2>&1 || { cat log.solidRates >&2; exit 1; }
