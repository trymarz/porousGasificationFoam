#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
# Solid only, one solid reactant (Eq. 5 with no gas factor). Ts sits well above
# Tcrit: at Tcrit the endothermic step drops the ODE below it mid-step.
python3 ../solidRates.py setup pyrolysis --reaction 'wood = targas' --coeffs '10 2000 300 1e4 1' --set Ts=600 T=600 || exit
restore0Dir
runApplication blockMesh || exit
runApplication $(getApplication) || exit
python3 ../solidRates.py check > log.solidRates 2>&1 || { cat log.solidRates >&2; exit 1; }
