#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
restore0Dir
# system/regressionFunctions measures gasTemperatureRise as T - 300.
[ "$(foamDictionary 0/T -entry internalField -value)" = "uniform 300" ] \
 || { echo "gasTemperatureRise assumes an initial T of 300 K" >&2; exit 1; }
runApplication blockMesh
runApplication $(getApplication) || exit
# Resistance pinned for the dp invariant: change it with 0.orig/Df and
# constant/porosityProperties, or system/regressionInvariants fails (#179).
python3 "${PGF_ROOT:-../../../..}/applications/test/regression/tools/porousResistanceStudy.py" \
    --expect . --df 1e8 --forchheimer 0 > log.dpExpectation 2>&1 || exit
