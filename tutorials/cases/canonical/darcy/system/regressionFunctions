regressionBase
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      all;
    postOperation   none;
    weightField     none;
    writeFields     false;
    writePrecision  10;
    writeToFile     true;
    log             false;
    enabled         false;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   -1;
}

regressionUAverage
{
    ${regressionBase}
    enabled         true;
    fields          (U);
    operation       volAverage;
    postOperation   mag;
}

regressionPInlet
{
    type            surfaceFieldValue;
    libs            (fieldFunctionObjects);
    regionType      patch;
    name            inlet;
    fields          (p);
    operation       areaAverage;
    writeFields     false;
    writePrecision  10;
    writeToFile     true;
    log             false;
    enabled         true;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   -1;
}

regressionPOutlet
{
    ${regressionPInlet}
    name            outlet;
}

regressionMassInlet
{
    ${regressionPInlet}
    fields          (phi);
    // phi is already a face-integrated mass flux, so do not multiply by area.
    operation       sum;
}

regressionMassOutlet
{
    ${regressionMassInlet}
    name            outlet;
}

// Gas heating by the pressure work, T - 300 so rtol bites on the rise itself
// (Allrun checks that 0.orig/T starts at 300 K).
gasTemperatureRise
{
    type            exprField;
    libs            (fieldFunctionObjects);
    field           gasTemperatureRise;
    dimensions      [0 0 0 1 0 0 0];
    expression      "T - 300";
    action          new;
    store           true;
    autowrite       false;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
}

regressionTRiseAverage
{
    ${regressionBase}
    enabled         true;
    fields          (gasTemperatureRise);
    operation       volAverage;
}

regressionTRiseMax
{
    ${regressionBase}
    enabled         true;
    fields          (gasTemperatureRise);
    operation       max;
}

