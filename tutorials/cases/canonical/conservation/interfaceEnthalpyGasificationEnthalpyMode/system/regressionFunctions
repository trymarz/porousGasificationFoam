regressionBase
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      all;
    postOperation   none;
    weightField     none;
    writeFields     false;
    writePrecision  12;
    writeToFile     true;
    log             false;
    enabled         false;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   -1;
}

// One cell, one open face, no interphase exchange (h = 0), no
// pressure work (dpdt no), Euler: the reaction heat and the gas crossing
// the interface move the temperatures.

// Baselines; the closed form is checked by checkInterfaceEnergy.py (Allrun).
regressionGasTempMax
{
    ${regressionBase}
    enabled         true;
    fields          (T);
    operation       max;
}

regressionTsMax
{
    ${regressionBase}
    enabled         true;
    fields          (Ts);
    operation       max;
}

// Liveness: O2 is consumed and CO released.
regressionCOMax
{
    ${regressionBase}
    enabled         true;
    fields          (CO);
    operation       max;
}

regressionO2Min
{
    ${regressionBase}
    enabled         true;
    fields          (O2);
    operation       min;
}

regressionSrho
{
    ${regressionBase}
    enabled         true;
    fields          (Srho);
    operation       volIntegrate;
}

regressionInterfaceEnthalpy
{
    ${regressionBase}
    enabled         true;
    fields          (interfaceEnthalpy);
    operation       volIntegrate;
}

// The solid heats the consumed O2 from Tg = 600 K towards Ts = 900 K.
regressionAgentHeatUp
{
    ${regressionBase}
    enabled         true;
    fields          (agentHeatUp);
    operation       volIntegrate;
}

// The enthalpy-mode reaction heat, -sum RR h(Ts).
regressionSolidChemistrySh
{
    ${regressionBase}
    enabled         true;
    fields          (solidChemistrySh);
    operation       volIntegrate;
}

