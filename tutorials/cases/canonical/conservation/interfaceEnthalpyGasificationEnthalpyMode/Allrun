#!/bin/sh
cd "${0%/*}" || exit
# interfaceEnthalpyReactantHeatUp in enthalpy mode (solidReactionEnergyFromEnthalpy
# true): char + 1.33 O2 = 2.33 CO, Ts = 900 K, Tg = 600 K, constant-Cp char.
# The reaction heat is -sum RR h(Ts) from formation enthalpies, and the solid
# still pays the O2 heat-up; checkInterfaceEnergy.py holds Tg, Ts, their sum
# and the absolute enthalpy per step against the closed form (#312 E2).
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
restore0Dir
runApplication blockMesh
runApplication $(getApplication)

python3 "${PGF_ROOT:-../../../../..}/tutorials/cases/canonical/conservation/checkInterfaceEnergy.py" \
    > log.checkInterfaceEnergy 2>&1 \
 || { echo "interface energy misses its closed form, see log.checkInterfaceEnergy" >&2; exit 1; }
