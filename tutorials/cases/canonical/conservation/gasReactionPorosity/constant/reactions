species
(
    N2 O2 CO CO2
);

reactions
{
    OxidationOfCarbonMonoxide
    {
        type     irreversibleArrheniusReaction;
        reaction "2 CO + O2 = 2 CO2";
        // 1000x the 1e10 the other tutorials use, so one 1e-6 s step
        // changes CO by ~1e-6 relative: well above roundoff, still linear.
        A        1e13;
        beta     0;
        Ta       15155.16;
    }
}
