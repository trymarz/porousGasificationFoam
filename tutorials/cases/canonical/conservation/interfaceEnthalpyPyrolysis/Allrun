#!/bin/sh
cd "${0%/*}" || exit
# Wood releases targas at Ts = Tg = 600 K. Products are born at Ts, so
# neither temperature moves; before #212 D4 the new gas was born at
# 298 K and Tg fell to 574 K in the first step.
# One cell, one open face, no interphase exchange (h = 0), hr = 0, no
# pressure work (dpdt no), Euler: only the gas crossing the interface moves
# either temperature (#212 D4).
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
restore0Dir
runApplication blockMesh
runApplication $(getApplication)
