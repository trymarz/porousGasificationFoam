FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      G;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    // Perfectly reflecting: snGrad(G) is zero, so qr is zero on every face and
    // the reservoir cannot balance itself through the boundary.
    wall
    {
        type            zeroGradient;
    }
}

