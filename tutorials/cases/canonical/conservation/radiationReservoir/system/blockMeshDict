FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 0.001;

// Four 1 mm cells in a row, every face a wall.  G leaves through nothing:
// the walls are zeroGradient, so the radiation reservoir is closed and the
// solid's net radiative book has to integrate to zero on its own.
vertices
(
    (0 0 0)
    (4 0 0)
    (4 1 0)
    (0 1 0)
    (0 0 1)
    (4 0 1)
    (4 1 1)
    (0 1 1)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (4 1 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    wall
    {
        type wall;
        faces
        (
            (0 4 7 3)
            (1 5 6 2)
            (0 1 5 4)
            (3 7 6 2)
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

mergePatchPairs
(
);

