FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      radiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

radiation       on;

heterogeneousRadiationModel  heterogeneousP1;

solverFreq 1;

heterogeneousAbsorptionEmissionModel heterogeneousConstantAbsorptionEmission;

// The gas is the only participant: a > 0, everything solid is zero.  In a
// closed box at uniform T the G equation gives G = 4 sigma T^4, so the gas
// absorbs exactly what it emits and its temperature must not move (#237).
heterogeneousConstantAbsorptionEmissionCoeffs
{
    a               a  [ 0 -1  0 0 0 0 0 ] 1;
    as              as [ 0 -1  0 0 0 0 0 ] 0;
    borderAs        borderAs [ 0 -1  0 0 0 0 0 ] 0;
    E               E  [ 1 -1 -3 0 0 0 0 ] 0.0;
    borderL         borderL  [ 0 1 0 0 0 0 0 ] 0;
}

scatterModel    constantScatter;

sigma           sigma [ 0 -1 0 0 0 0 0 ] 0;
C               C [ 0 0 0 0 0 0 0 ] 0;

