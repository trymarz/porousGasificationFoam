#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
restore0Dir
runApplication blockMesh
runApplication $(getApplication)

# Gas at radiative equilibrium must hold 1000 K (#237); before the fix it
# gained 85 K.  It settles 1e-3 K low once (solver tolerance), then holds.
python3 - <<'PY' || exit 1
import glob
drift = 0.0
for f in ("Min", "Max"):
    path = glob.glob(f"postProcessing/regressionGasTemp{f}/0/volFieldValue.dat")[0]
    rows = [l.split() for l in open(path) if not l.startswith("#")]
    drift = max(drift, max(abs(float(r[-1]) - 1000.0) for r in rows))
print(f"gasRadiativeEquilibrium: max |T - 1000 K| = {drift:.3e} K")
raise SystemExit(0 if drift < 1e-2 else 1)
PY
echo "gasRadiativeEquilibrium: PASS"
