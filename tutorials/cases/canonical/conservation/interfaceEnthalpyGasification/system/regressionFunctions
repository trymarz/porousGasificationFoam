regressionBase
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      all;
    postOperation   none;
    weightField     none;
    writeFields     false;
    writePrecision  12;
    writeToFile     true;
    log             false;
    enabled         false;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   -1;
}

// One cell, one open face, no interphase exchange (h = 0), hr = 0, no
// pressure work (dpdt no), Euler: nothing but the gas crossing the
// interface moves either temperature (#212 D4).

// The assertions: both temperatures stay at 900 K.
regressionGasTempMax
{
    ${regressionBase}
    enabled         true;
    fields          (T);
    operation       max;
}

regressionTsMax
{
    ${regressionBase}
    enabled         true;
    fields          (Ts);
    operation       max;
}

// Liveness: O2 is consumed and CO released.
regressionCOMax
{
    ${regressionBase}
    enabled         true;
    fields          (CO);
    operation       max;
}

regressionO2Min
{
    ${regressionBase}
    enabled         true;
    fields          (O2);
    operation       min;
}

regressionSrho
{
    ${regressionBase}
    enabled         true;
    fields          (Srho);
    operation       volIntegrate;
}

regressionInterfaceEnthalpy
{
    ${regressionBase}
    enabled         true;
    fields          (interfaceEnthalpy);
    operation       volIntegrate;
}

// Zero to roundoff: the solid heats O2 from Tg to Ts = Tg.
regressionAgentHeatUp
{
    ${regressionBase}
    enabled         true;
    fields          (agentHeatUp);
    operation       volIntegrate;
}

