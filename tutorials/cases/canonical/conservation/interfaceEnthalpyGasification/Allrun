#!/bin/sh
cd "${0%/*}" || exit
# char + 1.33 O2 = 2.33 CO at Ts = Tg = 900 K, gas reaction off. CO is
# born at Ts and O2 leaves the gas at Tg, so neither temperature moves
# (900 K, not 1000 K: the JANAF fits switch at Tcommon = 1000 K).
# One cell, one open face, no interphase exchange (h = 0), hr = 0, no
# pressure work (dpdt no), Euler: only the gas crossing the interface moves
# either temperature (#212 D4).
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
restore0Dir
runApplication blockMesh
runApplication $(getApplication)
