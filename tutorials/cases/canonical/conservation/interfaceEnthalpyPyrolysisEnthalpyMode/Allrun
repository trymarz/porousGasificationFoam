#!/bin/sh
cd "${0%/*}" || exit
# wood = targas in enthalpy mode (solidReactionEnergyFromEnthalpy true), wood
# Hf = -3e5 J/kg, constant Cp, Ts = 700 K above Tg = 600 K. The reaction heat
# is -sum RR h(Ts) from formation enthalpies; checkInterfaceEnergy.py holds Tg,
# Ts, their sum and the absolute enthalpy per step against the closed form.
# One cell, one open face, h = 0, dpdt no, Euler (#312 E2).
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
restore0Dir
runApplication blockMesh
runApplication $(getApplication)

python3 "${PGF_ROOT:-../../../../..}/tutorials/cases/canonical/conservation/checkInterfaceEnergy.py" \
    > log.checkInterfaceEnergy 2>&1 \
 || { echo "interface energy misses its closed form, see log.checkInterfaceEnergy" >&2; exit 1; }
