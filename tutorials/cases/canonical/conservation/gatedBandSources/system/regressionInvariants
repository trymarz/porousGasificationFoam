# Declared invariants, checked by applications/test/regression/tools/checkInvariants.py
# before the baseline comparison; a run that breaks one is never recaptured.
# <functionObject> <column> <check> <args>; see doc/regression-testing.md.

# Every cell is dispersed from t = 0, so no gated source may be anything but zero.
regressionRadiationSh   volIntegrate(radiationSh)       zero  1e-12
regressionChemistrySh   volIntegrate(solidChemistrySh)  zero  1e-12
regressionHeatTransfer  volIntegrate(heatTransfer)      zero  1e-12
regressionInterfaceEnthalpy  volIntegrate(interfaceEnthalpy)  zero  1e-12
regressionAgentHeatUp        volIntegrate(agentHeatUp)        zero  1e-12
regressionSrho          volIntegrate(Srho)              zero  1e-12

# With every source gated off nothing drives either phase: both stay where they start.
regressionTsMax       max(Ts)  ==  1200  1e-6
regressionGasTempMax  max(T)   ==  300   1e-6
