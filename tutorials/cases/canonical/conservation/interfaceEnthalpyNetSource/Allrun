#!/bin/sh
cd "${0%/*}" || exit
# char + 2.67 O2 = 3.67 CO2 and coke + 3.67 CO2 = 4.67 CO, Ts = 900 K, Tg = 600 K,
# hr = 0: CO2 is made and consumed in every step. The interface terms use its
# net source (#312 E6): a product entering at Ts (step 1), then a reactant the
# solid heats from Tg. Gross bookkeeping would have the solid pay the heat-up of
# min(made, consumed) and the gas gain it: same total, other split. Checked per
# step by checkInterfaceEnergy.py, which prints that shift. One cell, h = 0, Euler.
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
restore0Dir
runApplication blockMesh
runApplication $(getApplication)

python3 "${PGF_ROOT:-../../../../..}/tutorials/cases/canonical/conservation/checkInterfaceEnergy.py" --both-ways CO2 \
    > log.checkInterfaceEnergy 2>&1 \
 || { echo "interface energy misses its closed form, see log.checkInterfaceEnergy" >&2; exit 1; }
