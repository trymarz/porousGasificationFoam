// The gas EEqn's interface source, both halves summed: net-consumed O2
// (and CO2 after step 1) leaves at Tg, net-made CO (and CO2) enters at Ts.
gasInterfaceEnthalpy
{
    type            exprField;
    libs            (fieldFunctionObjects);
    field           gasInterfaceEnthalpy;
    dimensions      [1 -1 -3 0 0 0 0];
    expression      "gasProductEnthalpyAtTs + gasReactantEnthalpyAtTg";
    action          new;
    store           true;
    autowrite       true;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
}

regressionBase
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      all;
    postOperation   none;
    weightField     none;
    writeFields     false;
    writePrecision  12;
    writeToFile     true;
    log             false;
    enabled         false;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   -1;
}

// One cell, one open face, no interphase exchange (h = 0), hr = 0, no
// pressure work (dpdt no), Euler: nothing but the gas crossing the
// interface moves either temperature (#212 D4).

// Baselines; the closed form is checked by checkInterfaceEnergy.py (Allrun).
regressionGasTempMax
{
    ${regressionBase}
    enabled         true;
    fields          (T);
    operation       max;
}

regressionTsMin
{
    ${regressionBase}
    enabled         true;
    fields          (Ts);
    operation       min;
}

// Liveness: O2 is consumed and CO released.
regressionCOMax
{
    ${regressionBase}
    enabled         true;
    fields          (CO);
    operation       max;
}

regressionO2Min
{
    ${regressionBase}
    enabled         true;
    fields          (O2);
    operation       min;
}

regressionCO2Max
{
    ${regressionBase}
    enabled         true;
    fields          (CO2);
    operation       max;
}

regressionSrho
{
    ${regressionBase}
    enabled         true;
    fields          (Srho);
    operation       volIntegrate;
}

regressionGasInterfaceEnthalpy
{
    ${regressionBase}
    enabled         true;
    fields          (gasInterfaceEnthalpy);
    operation       volIntegrate;
}

// The solid heats the net-consumed O2 (and CO2 after step 1) from Tg to Ts.
regressionHeatUpGasReactantsToTs
{
    ${regressionBase}
    enabled         true;
    fields          (heatUpGasReactantsToTs);
    operation       volIntegrate;
}

