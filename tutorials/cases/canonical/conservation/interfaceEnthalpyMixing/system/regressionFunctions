regressionBase
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      all;
    postOperation   none;
    weightField     none;
    writeFields     false;
    writePrecision  12;
    writeToFile     true;
    log             false;
    enabled         false;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   -1;
}

// One cell, one open face, no interphase exchange (h = 0), hr = 0, no
// pressure work (dpdt no), Euler: nothing but the gas crossing the
// interface moves either temperature (#212 D4).

// Asserted: the solid stays at 700 K. The gas temperature is checked by
// checkMixingTemperature.py against the mixing value from hs.
regressionTsMax
{
    ${regressionBase}
    enabled         true;
    fields          (Ts);
    operation       max;
}

regressionGasTempMax
{
    ${regressionBase}
    enabled         true;
    fields          (T);
    operation       max;
}

regressionTargasMax
{
    ${regressionBase}
    enabled         true;
    fields          (targas);
    operation       max;
}

regressionSrho
{
    ${regressionBase}
    enabled         true;
    fields          (Srho);
    operation       volIntegrate;
}

regressionInterfaceEnthalpy
{
    ${regressionBase}
    enabled         true;
    fields          (interfaceEnthalpy);
    operation       volIntegrate;
}

