regressionBase
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      all;
    postOperation   none;
    weightField     none;
    writeFields     false;
    writePrecision  10;
    writeToFile     true;
    log             false;
    enabled         false;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
    writeInterval   -1;
}

regressionAverage
{
    ${regressionBase}
    enabled         true;
    fields          (Ts targas);
    operation       volAverage;
}

regressionTsMax
{
    ${regressionBase}
    enabled         true;
    fields          (Ts);
    operation       max;
}

regressionTsMin
{
    ${regressionBase}
    enabled         true;
    fields          (Ts);
    operation       min;
}

regressionPorosityAverage
{
    ${regressionBase}
    enabled         true;
    fields          (porosityF);
    operation       volAverage;
}

regressionWoodIntegral
{
    ${regressionBase}
    enabled         true;
    fields          (Ywood);
    operation       volIntegrate;
}

