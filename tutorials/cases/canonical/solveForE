#!/bin/sh
# Solve canonical case $1 for e instead of h in the calling case, then fail if
# its outputs differ from $1's committed reference by more than rtol $2 (#132).
h="../$1"
cp -r "$h/0.orig" "$h/constant" "$h/system" . || exit
foamDictionary constant/thermophysicalProperties \
    -entry thermoType/energy -set sensibleInternalEnergy > /dev/null || exit
foamDictionary system/fvSchemes \
    -entry 'divSchemes/div(phi,e)' -add 'Gauss upwind' > /dev/null || exit
foamDictionary system/fvSchemes \
    -entry 'divSchemes/div(phiv,p)' -add 'Gauss linear' > /dev/null || exit
sed -i 's/"(U|h|/"(U|h|e|/' system/fvSolution || exit

. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
restore0Dir
runApplication blockMesh || exit
runApplication $(getApplication) || exit

python3 ../../../../applications/test/regression/tools/compareScalars.py \
    --reference "$h/reference/postProcessing" --candidate postProcessing \
    --rtol "$2" > log.compareH 2>&1 \
 || { echo "e and h forms of $1 differ beyond rtol $2, see log.compareH" >&2; exit 1; }
