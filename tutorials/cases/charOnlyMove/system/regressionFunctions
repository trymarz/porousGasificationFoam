//
// Regression-test function objects for charOnlyMove.
//
// Verbatim syntax verified against:
//   gitlab.com/openfoam/core/openfoam/-/raw/master/tutorials/incompressible/
//     pisoFoam/RAS/cavity/system/FOs/FOvolFieldValue
//
// Each block emits one tab-separated row per timestep to
//   postProcessing/<name>/<startTime>/volFieldValue.dat
//
// applications/test/regression/tools/compareScalars.py diffs every such
// .dat against the committed reference/ baseline.

regressionBase
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      all;
    postOperation   none;
    weightField     none;
    writeFields     false;     // Only the scalar reduction; no field dump.
    writePrecision  10;
    writeToFile     true;
    log             false;
    enabled         true;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    timeStep;
    writeInterval   1;
}

// Volume integral of porosity. Bed-motion-sensitive and replenishment-sensitive.
regressionPorosityIntegral
{
    ${regressionBase}
    fields          (porosityF);
    operation       volIntegrate;
}

// Volume integrals of solid mass fractions. Chemistry-sensitive.
regressionSolidSpeciesIntegrals
{
    ${regressionBase}
    fields          (Ychar Yash Yhum Yrubberwood);
    operation       volIntegrate;
}

// Solid temperature reductions. Energy-equation-sensitive.
regressionTsAverage
{
    ${regressionBase}
    fields          (Ts);
    operation       volAverage;
}

regressionTsMax
{
    ${regressionBase}
    fields          (Ts);
    operation       max;
}

regressionTsMin
{
    ${regressionBase}
    fields          (Ts);
    operation       min;
}

