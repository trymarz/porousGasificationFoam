FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Ts;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    outlet
    {
        type            zeroGradient;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 300;
        // fresh wood fed at ambient, setFieldsDict's 300 K default; the bed
        // itself starts at 400 K
    }
    wall
    {
        type            zeroGradient;
    }
    nozzle
    {
        type            zeroGradient;
    }
    sides
    {
        type            empty;
    }
}


