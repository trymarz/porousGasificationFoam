FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidThermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType solidMixtureThermo<constHeterogeneous>;

#include "../../../../thermoData/solidThermoData"

solidComponents
(
    char ash wood
);

charCoeffs { $park2010Char; }

woodCoeffs
{
    transport
    {
        K           0.23;  // Park et al. via Ibrahim (2025)
    }
    thermodynamics
    {
        Cp          2000;  // Park et al. via Ibrahim (2025)
        Hf          -4.675e6; // -109870 J/mol / 0.0235 kg/mol (Ibrahim 2025)
    }
    density
    {
        rho          1050;
        rhoApparent  630;  // = rho*(1 - 0.4): Park et al. (2010) wood porosity
    }
};

ashCoeffs
{
    transport
    {
        K           0.15;
    }
    thermodynamics
    {
        Cp          2400;
        Hf          -12.38e6;
    }
    density
    {
        rho           3000;
        rhoApparent   3000; // = rho: non-porous, fixture value
    }
};

