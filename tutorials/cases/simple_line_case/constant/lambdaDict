FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      lambdaDict;
}


lambdaMode exactDifferential; // constant or exactDifferential


//INFO:
//constant:
// lambdaDot = lambdaValue
//exactDifferential:
// lambdaDot  = dlambdaOverDTs*(Ts_now - Ts_old)/deltaT
// lambdaDot += splitMassBetweenLamAndPor
//              * sum_i( dlambdaOverDYmi_i * sRhoS_i ),
//              over the solid species; the remaining
//              (1 - splitMassBetweenLamAndPor) share of the chemistry mass
//              change becomes pore space instead.
// Leaving every coefficient at its 0.0 default gives lambdaDot = 0, which is
// why there is no separate "off" mode.


//exactDifferential parameters
// dlambdaOverDTs 0.001 reproduces the linear lambdaDot = 0.001*x this case
// used under the removed dTsdt mode. splitMassBetweenLamAndPor 0 leaves the
// whole chemistry mass change in the porosity source, as before, so
// dlambdaOverDYmi has no effect here; it is spelled out to show the key.
dlambdaOverDTs 0.001;               // [m/K]
dlambdaOverDYmi 0.0;                // [m^4/kg], or a per-specie subdict
splitMassBetweenLamAndPor 0;        // [-], in [0,1]


interpolateUs true; // true: interpolate UsDEM into a continuous Us field inside solid cells. false: use only raw UsDEM, so cells without sphere centers keep Us = 0.

interpolationMode laplaceSetValues; //laplaceAnchored;
// laplaceAnchored: current soft anchored solve.
// laplaceSetValues: pgfVeloInt hard setValues Laplace solve.


//laplaceSetValues mode parameters
nLaplaceSetValuesCorrectors 0; // 0: no extra corrector. 1 or more: extra pseudo-time diffusion smoothing steps after laplaceSetValues interpolation.



//laplaceAnchored mode parameters

        demVelocityAnchorCoeff 1e6; // constraint strength that keeps cells with sphere centers close to their raw UsDEM value. Larger value: occupied cells follow UsDEM more strictly. Smaller value: occupied-cell velocity is smoothed more by neighbors.
        //Larger demVelocityAnchorCoeff strengthens the influence of DEM cells.

        backgroundUsAnchorCoeff 1e-12; // small regularization for empty solid cells so the interpolation equation remains well posed. Larger value: empty solid cells are weakly pulled toward zero. Smaller value: interpolation spreads more freely from DEM cells.

        nUsInterpolationCorrectors 2; // Number of interpolation/smoothing solves used to fill Us in solid cells without particles. Larger value: smoother and more diffused Us field. Smaller value: sharper, more local interpolation.



// lambda interpolation: same two strategies as Us, on their own keys, so
// lambda (which YADE owns and PGF only reads back) can be smoothed
// independently of the solid velocity. Defaults shown.

        interpolateLambda true;                  // false: take lambdaDEM raw, background cells pinned
        lambdaInterpolationMode laplaceSetValues; // laplaceAnchored or laplaceSetValues
        lambdaBackgroundValue 1.0;               // [m] value held outside the solid region
