thermoType solidMixtureThermo<constHeterogeneous>;

#include "../../../../thermoData/solidThermoData"

solidComponents
(
    wood char1 char hum 
);

humCoeffs
{
    transport
    {
	    K           0.58;
    }
    thermodynamics
    {
        Cp          4200;
        Hf         -15.86e6;
    }
    density
    {
        rho         1000;
    }
};

char1Coeffs { $park2010IntermediateSolid; }

charCoeffs { $park2010Char; }

woodCoeffs { $park2010Wood; }

