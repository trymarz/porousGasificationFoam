#!/bin/sh
#
# LEIgasifierR2 — Allrun
# ======================
# Rung R2 of issue #64: R1 (the LEI outline, cold, inert N2) plus feed and
# discharge: spheres enter at the top at a fixed rate and leave at the grate.
# Settles the bed, checks the DEM walls, runs coupled, then checks the solid
# mass balance, the bed level and the gas flow. See README.md.
#
# PREREQUISITES
#   - porousGasificationFoam built with pgf build --yade (pgf run . picks --yade)
#   - Yade built with FoamCoupling support, `yade` on PATH
#
# CFD-only cold-flow check (README.md): set `active false` in
#   constant/yadeProperties and `endTime 10` in system/controlDict, then run
#   steps 1-2 and `porousGasificationFoam` serially.

set -e   # abort on first error

cd "${0%/*}" || exit

# 1. Mesh from the geometry table, then fields.
python3 leiGeometry.py
cp -r 0.orig 0
blockMesh
checkMesh
setFields

# 2. Settle the bed under gravity, then check walls and packing.
yade -n -x relax.py
yade -n -x checkDemWalls.py

# 3. Coupled run (2 Yade ranks; FoamCoupling spawns 2 OpenFOAM ranks).
#    Yade must run exactly endTime/dem_dt substeps: no early-exit handshake.
decomposePar
YADE_DT=$(sed -n 's/^dem_dt *= *\([0-9.eE+-]*\).*/\1/p' demGeometry.py)
END_TIME=$(foamDictionary -entry endTime -value system/controlDict)
export YADE_NSTEPS=$(awk -v t="$END_TIME" -v dt="$YADE_DT" 'BEGIN { printf "%d", t / dt + 0.5 }')
echo "YADE_NSTEPS = $YADE_NSTEPS (endTime $END_TIME / yadeDt $YADE_DT)"
mpirun -n 2 yade MPI_lambda.py

# 4. Solid mass balance, bed level and gas flow (balance.txt, postProcessing).
python3 checkFeed.py
