FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Us;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// DEM-derived: FoamCoupling maps sphere velocities onto solid cells.
// No solid crosses a gas port; walls slip.

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    primaryInlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    secondaryInlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    outlet
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    wall
    {
        type            slip;
    }
    frontAndBack
    {
        type            empty;
    }
}

