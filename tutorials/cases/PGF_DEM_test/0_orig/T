FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    wallTop
    {
        type            zeroGradient;
    }
    wallSides
    {
        type            zeroGradient;
    }
    wallBottom
    {

         type            fixedValue;
        value           uniform 300;
    }

}


