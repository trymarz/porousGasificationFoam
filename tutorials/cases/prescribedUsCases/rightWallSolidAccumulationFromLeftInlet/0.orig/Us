FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Us;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Prescribed solid velocity. setFields initializes the interior to +x motion;
// the left boundary supplies solid and the right wall stops it.
dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    left
    {
        type            fixedValue;
        value           uniform (0.01 0 0);
    }
    right
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    "(bottom|top|front|back)"
    {
        type            empty;
    }
}

