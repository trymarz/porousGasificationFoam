FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidThermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType solidMixtureThermo<constHeterogeneous>;

// Four inert components with deliberately different skeletal densities. The
// prescribed Us advects their mixed mass concentrations with one shared solid
// volume flux, so density weighting is exercised independently of chemistry.
#include "../../../../../thermoData/solidThermoData"

solidComponents ( char ash wood mineral );

charCoeffs { $park2010Char; }

ashCoeffs
{
    transport
    {
        K           0.25;
    }
    thermodynamics
    {
        Cp          850;
        Hf          -1.0e4;
    }
    density
    {
        rho         2500;
        rhoApparent 2500; // = rho: non-porous, fixture value
    }
}

woodCoeffs
{
    transport
    {
        K           0.08;
    }
    thermodynamics
    {
        Cp          1600;
        Hf          -3.0e4;
    }
    density
    {
        rho         650;
        rhoApparent 650; // = rho: non-porous, fixture value
    }
}

mineralCoeffs
{
    transport
    {
        K           1.2;
    }
    thermodynamics
    {
        Cp          700;
        Hf          -5.0e3;
    }
    density
    {
        rho         3000;
        rhoApparent 3000; // = rho: non-porous, fixture value
    }
}

