FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      pyrolysisProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Pyrolysis active so volPyrolysis::solveSpeciesMass() runs and transports the
// fresh solid from the left inlet by Us. With chemistry off the reaction source
// is zero, so the species equation is pure advection and accumulation.
active          true;

heterogeneousPyrolysisModel  volPyrolysis;

pyrolysisCoeffs
{
    subintegrateHeatTransfer false;
    bedCollapse      false;
    criticalPorosity 0.9999;
    replenish        false;

    // Deliberately permit exact solid occupation so the receiver limiter and
    // zero-void gas safeguards are exercised.
    minPorosity      0;
    solidStateTolerance 1e-10;
    nSolidFluxLimiterCorrectors 8;
}

infoOutput      true;

