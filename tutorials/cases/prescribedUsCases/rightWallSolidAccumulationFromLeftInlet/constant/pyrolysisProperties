FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      pyrolysisProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Pyrolysis active so SolidSpeciesTransport::solve() runs and transports the
// fresh solid from the left inlet by Us. With chemistry off the reaction source
// is zero, so the species equation is pure advection and accumulation.
active          true;

heterogeneousPyrolysisModel  volPyrolysis;

pyrolysisCoeffs
{
    subintegrateHeatTransfer false;
    bedCollapse      false;
    replenish        false;

    nSolidFluxLimiterCorrectors 8;

    // Solid regimes, by solid volume fraction alpha = 1 - porosityF.
    // Each threshold ends the regime below it:
    // empty (alpha = 0) | trace | dispersed | connected | maxSolidFraction
    solidRegimes
    {
        dispersedAboveSolidFraction  1e-10;   // below: trace, Ts follows the gas
        connectedAboveSolidFraction  0.0001;  // below: dispersed, no solid sources, may be emptied
        // Solid arrives at porosity 0.5 and piles against the right wall, so the
        // first half of the run is inlet-driven filling and the receiver cap only
        // binds once the wall cells have packed up to 0.9.
        maxSolidFraction             0.9;     // connected up to here; never exceeded
        dispersedSolidTemperature    solid;   // solid | gas
    }

    // Slack the fail-fast checks allow, in solid fraction; changes no result.
    solidStateCheckTolerance 1e-10;
}

infoOutput      true;

