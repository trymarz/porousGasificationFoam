// Tetris fixture: the empty domain is filled from the top by pure char moving
// downward. The bottom wall has zero solid velocity, so each incoming figure
// is pressed onto the compacting bed below it.

defaultFieldValues
(
    volScalarFieldValue porosityF  1
    volScalarFieldValue porosityF0 1
    volVectorFieldValue Us         (0 -0.1 0)
);

