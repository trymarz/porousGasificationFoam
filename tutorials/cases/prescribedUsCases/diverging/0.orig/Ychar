FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Ychar;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Solid-phase mass fraction of the only solid component: 1 everywhere.
// The blob is defined by porosityF (solid amount), not by this fraction.
dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1.0;

boundaryField
{
    "(left|right|bottom|top)"
    {
        type            zeroGradient;
    }
    "(front|back)"
    {
        type            empty;
    }
}

