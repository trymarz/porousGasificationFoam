# Declared invariants, checked by applications/test/regression/tools/checkInvariants.py
# before the baseline comparison; a run that breaks one is never recaptured.
# <functionObject> <column> <check> <args>; see doc/regression-testing.md.

# Closed box, no chemistry: transport conserves the char mass and the solid volume.
regressionYcharmIntegral   volIntegrate(Ycharm)   constant  1e-9
regressionPorosityAverage  volAverage(porosityF)  constant  1e-9

# A void fraction above 1 is a negative volume of solid.
regressionPorosityMax    max(porosityF)        <=  1
# The receiver cap: no cell holds more than maxSolidFraction 0.6.
regressionPorosityMin    min(porosityF)        >=  0.4  1e-9
# An overshooting advection scheme drives the mass concentration negative.
regressionYcharmMin      min(Ycharm)           >=  0
