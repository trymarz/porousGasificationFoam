FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;

    // Solid-species advection by the prescribed Us field: the operator
    // under test (volPyrolysis::solveSpeciesMass -> div(phiUs, Ym)).
    div(phiSolid)   Gauss upwind;
    div(phiRhoCp)   Gauss SuperBee;
    div(phi,U)      Gauss linearUpwindV default;
    div(phi,Yi)     Gauss upwind;
    div(phi,h)      Gauss upwind;
    div(phi,K)      Gauss upwind;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear limited 1;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         limited 1;
}

