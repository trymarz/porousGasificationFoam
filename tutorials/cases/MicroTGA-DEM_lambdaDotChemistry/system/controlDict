FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     porousGasificationFoam;

startFrom       startTime;

startTime       0; 

stopAt          endTime;

// Short: fixture only needs enough coupling steps past the first
// (zeroed) exactDifferential call to sample a settled lambdaDot value.
endTime         0.002;

deltaT          1e-6;

writeControl    adjustableRunTime;

writeInterval   0.0002;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep no;

maxCo       0.5; 

maxDi       5000;

maxDeltaT	0.05;

functions
{
    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          ("p,U,Ts");
    }

    solidBedFieldValueBase
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        regionType      cellZone;
        name            solidBed;
        postOperation   none;
        weightField     none;
        writeFields     false;
        writePrecision  10;
        writeToFile     true;
        log             false;
        enabled         false;      // template; children override
        executeControl  timeStep;
        executeInterval 1;
        writeControl    writeTime;
        writeInterval   -1;
    }

    lambdaDotAverage
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambdaDot);
        operation       average;
    }

    lambdaDotMin
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambdaDot);
        operation       min;
    }

    lambdaDotMax
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambdaDot);
        operation       max;
    }

    lambdaAverage
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambda);
        operation       average;
    }

    lambdaMin
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambda);
        operation       min;
    }

    lambdaMax
    {
        ${solidBedFieldValueBase}
        enabled         true;
        fields          (lambda);
        operation       max;
    }

    #includeFunc probes
}

// ************************************************************************* //
