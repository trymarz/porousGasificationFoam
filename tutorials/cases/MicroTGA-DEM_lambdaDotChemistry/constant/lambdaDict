FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      lambdaDict;
}

// Regression fixture: chemistry-driven term only (dlambdaOverDTs 0). Exercises
// calculateChemistryDriven()'s per-specie accumulation of
// splitMassBetweenLamAndPor*dlambdaOverDYmi*sRhoSi. sRhoSi is negative while
// solid mass is being consumed, so a positive dlambdaOverDYmi gives the
// negative lambdaDot (shrinkage) this fixture asserts.
// Valid modes: constant, exactDifferential. exactDifferential reads
// dlambdaOverDTs [m/K], dlambdaOverDYmi [m^4/kg] (a scalar, or a per-specie
// subdict) and splitMassBetweenLamAndPor [-], all defaulting to 0.0.
// setFieldsDict seeds the packed-bed box with porosityF < criticalPorosity;
// 0.orig/Ts and 0.orig/T start the whole domain hot (Ts=800, T=850) so both
// the temperature gradient and the pyrolysis chemistry are active from t=0.
lambdaMode exactDifferential;

dlambdaOverDTs 0.0;

// [m^4/kg]. Tuned by running this fixture, not derived. The term is linear in
// this coefficient: 1e-6 measures as a mean lambdaDot of -1.71e-4 m/s over the
// fixture's 360 solid cells, so 2.5e-6 gives about -4.3e-4 m/s. Large enough to
// move lambda visibly over the run, and about 4x below the temperature term of
// the Both fixture, which has to keep that sum positive.
// A fixture-tuning value, not a physical one: a shrinking-particle model that
// loses a third of its length over full conversion of ~140 kg/m^3 of solid is
// nearer 1e-3, which would swamp the temperature term here.
// One value for every solid specie; a per-specie subdict would be
// dlambdaOverDYmi { char 2.5e-6; wood 1e-6; }, species left out reading 0.0.
dlambdaOverDYmi 2.5e-6;

splitMassBetweenLamAndPor 0.5;
