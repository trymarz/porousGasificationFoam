8
(
    inlet
    {
        type            wall;
        inGroups        1(wall);
        nFaces          20;
        startFace       5050;
    }
    outlet
    {
        type            wall;
        inGroups        1(wall);
        nFaces          0;
        startFace       5070;
    }
    wall
    {
        type            wall;
        inGroups        1(wall);
        nFaces          130;
        startFace       5070;
    }
    axis
    {
        type            empty;
        inGroups        1(empty);
        nFaces          0;
        startFace       5200;
    }
    back
    {
        type            wedge;
        inGroups        1(wedge);
        nFaces          2600;
        startFace       5200;
    }
    front
    {
        type            wedge;
        inGroups        1(wedge);
        nFaces          2600;
        startFace       7800;
    }
    procBoundary1to0
    {
        type            processor;
        inGroups        1(processor);
        nFaces          130;
        startFace       10400;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        1;
        neighbProcNo    0;
    }
    procBoundary1to3
    {
        type            processor;
        inGroups        1(processor);
        nFaces          20;
        startFace       10530;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        1;
        neighbProcNo    3;
    }
)

