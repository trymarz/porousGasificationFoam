FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Pack a dry-wood bed into the lower part of the column (z = 0.05 -> 0.30).
// Outside the bed porosityF = 1 (pure gas, no solid). Inside, porosityF = 0.40
// and the solid is 100 % wood (Ywood = 1, Ychar = 0). YADE places ~100
// particles in this same region (see MPI_lambda.py).

defaultFieldValues
(
    volScalarFieldValue porosityF  1.0
    volScalarFieldValue porosityF0 1.0
    volScalarFieldValue Ywood      0.0
    volScalarFieldValue Ychar      0.0
);

regions
(
    boxToCell
    {
        box (0 0 0.05) (0.05 0.05 0.30);
        fieldValues
        (
            volScalarFieldValue porosityF  0.40
            volScalarFieldValue porosityF0 0.40
            volScalarFieldValue Ywood      1.0
            volScalarFieldValue Ychar      0.0
        );
    }
);

