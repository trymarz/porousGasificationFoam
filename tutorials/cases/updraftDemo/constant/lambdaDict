    format      ascii;
    class       dictionary;
    location    "constant";
    object      lambdaDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Per-cell rate of change of the particle "lambda" (rest-length / shrink
// factor) that PGF sends back to YADE each coupling step. lambdaDotModel reads
// this as a Function1<scalar> and evaluates it with the cell-centre
// y-coordinate as the single argument `x` (see lambdaDotModel.C). A positive
// value drives particle shrinkage in MPI_lambda.py.
//
// Uniform shrink rate: 0.9995 per timestep (0.05 % contraction), so after
// ~1400 steps particles are at half their original radius.  Replace with a
// function of `x` (the cell-centre y-coordinate) for a spatially varying rate.

lambdaDot
{
    type    coded;
    code
    #{
        return 0.9995;
    #};
}

