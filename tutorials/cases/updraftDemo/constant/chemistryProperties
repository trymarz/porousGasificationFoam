FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistry           on;

chemistryType
{
    solver            ode;
}

solidChemistryType
{
    solver              solidOde;
    method              ODESolidHeterogeneousChemistryModel;
    solidThermoType     const<constRad<constThermo<constRho>>>;
}

initialChemicalTimeStep 1e-10;

turbulentReaction   off;
solidReactionEnergyFromEnthalpy false;
stoichiometricReactions false;
showRelativeReactionRates false;
solidChemistryTimeStepControl false;

diffusionLimitedReactions true;

odeCoeffs
{
    solver      seulex;
}

solidOdeCoeffs
{
    solver      RKCK45;
    absTol      1e-8;
    relTol      1e-6;
}

// Gas-phase species list + (empty) homogeneous reaction set.
#include "reactions"

// Primary wood pyrolysis — three parallel paths.  In real gasifier conditions
// (slow heating, thick particles) roughly 65–75 % of dry wood mass devolatilises
// while 25–35 % remains as char.  The Ranzi coefficients used here (R24a 0.74 %
// char, R24b 57.4 % gas, R24c 41.6 % tar) are for fast-pyrolysis conditions;
// the char-core cap in MPI_lambda.py (min radius ~0.67 r₀) enforces the
// physically correct ~30 % char residual for visual realism on the poster.
//
// Coefficient tuple: (A  Ta  Tcrit  deltaH  n)
//   A      pre-exponential factor          [1/s]
//   Ta     activation temperature E/R      [K]
//   Tcrit  no reaction below this T        [K]
//   deltaH heat of reaction (>0 endothermic) [J/kg]
//   n      reaction order in the solid
solidReactions
(
    // R24a — char formation (0.74 %)
    // Poster kinetics: Ta 8kK fires at 600-800K, ΔH negative = exothermic.
    irreversibleSolidArrheniusHeterogeneousReaction
    0.0074 wood = 0.0074 char
    (2.0e5 8000 300 -7.5e4 1)

    // R24b — permanent-gas release (57.4 %)
    irreversibleSolidArrheniusHeterogeneousReaction
    0.5738 wood = 0.2063 CO + 0.3387 CO2 + 0.0288 H2
    (2.0e5 8000 300 -7.5e4 1)

    // R24c — tar + light-gas release (41.6 %)
    irreversibleSolidArrheniusHeterogeneousReaction
    0.4158 wood = 0.0567 H2O + 0.0171 CH4 + 0.3420 tar
    (2.0e5 8000 300 -7.5e4 1)
);

