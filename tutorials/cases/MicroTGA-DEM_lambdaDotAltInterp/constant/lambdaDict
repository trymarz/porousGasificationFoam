FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      lambdaDict;
}

// Regression fixture: same chemistry-driven-only setup as
// MicroTGA-DEM_lambdaDotChemistry, but exercising the paths that fixture
// leaves untouched -- laplaceAnchored interpolation, a per-specie
// dlambdaOverDYmi subdict, and a non-default lambdaBackgroundValue.
// exactDifferential reads dlambdaOverDTs/dlambdaOverDYmi/
// splitMassBetweenLamAndPor (default 0.0); setFieldsDict seeds the packed
// bed, domain starts hot (Ts=800, T=850) so both terms are active from t=0.
lambdaMode exactDifferential;

dlambdaOverDTs 0.0;

// Per-specie form (Chemistry uses the uniform-scalar form). solidComponents
// here are wood, char1, char, hum -- only wood/char1 get a nonzero
// coefficient, so char/hum read the 0.0 default. wood is the dominant
// reactant (sRhoSi < 0, drives the asserted negative sign); char1 is a
// transient intermediate; char (sRhoSi > 0) is deliberately left out so its
// positive contribution isn't netted against wood's, unlike Chemistry.
dlambdaOverDYmi
{
    wood  2.5e-6;
    char1 2.5e-6;
}

splitMassBetweenLamAndPor 0.5;

// Alternate interpolation strategy (the other four fixtures use the
// laplaceSetValues default) -- see laplaceAnchored.C. Falls back to Us's
// default solver controls when no matching fvSolution entry exists.
lambdaInterpolationMode laplaceAnchored;

// Non-default background for non-solid cells (default 1.0 m) -- a
// PGF-mesh-side diagnostic only; YADE's State::lambda_ has no dependency
// on it, so unlike the other keys this cannot move the DEM packing or sign.
lambdaBackgroundValue 0.5;
