FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Inlet mass flows: Table 3 air flows (primary 30, secondary 5 Nm3/h)
// carried as N2 and mapped to the slab by the planar-2D rule in README.md.

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    primaryInlet
    {
        type            flowRateInletVelocity;
        massFlowRate    constant 3.5363e-4;  // R2 x 300/900: R2's volume flow, hot
        value           uniform (0 0 0);
    }
    secondaryInlet
    {
        type            flowRateInletVelocity;
        massFlowRate    constant 3.9293e-5;  // R2 x 300/900
        value           uniform (0 0 0);
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
    wall
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}

