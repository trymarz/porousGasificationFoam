FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     porousGasificationFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

// Fixed deltaT: Yade runs exactly endTime/dem_dt substeps (Allrun). R2's
// 4e-3 gives Courant ~3 once pyrolysis gas flows; 1e-3 keeps it below 1.
endTime         2.5;

deltaT          1e-3;

maxDeltaT       1e-3;

writeControl    adjustableRunTime;

writeInterval   0.1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep no;

maxCo      1;

maxDi      5000;

functions
{
    // Gas mass flow through each port; inflow negative.
    portFlow
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        writeControl    timeStep;
        writeInterval   1;
        log             false;
        regionType      patch;
        operation       sum;
        fields          (phi);
        writeFields     false;
        name            outlet;
    }
    primaryFlow   { $portFlow; name primaryInlet; }
    secondaryFlow { $portFlow; name secondaryInlet; }

    // Species mass flow out of the outlet, for checkHotBed.py's element balance.
    outletSpecies
    {
        $portFlow;
        operation       weightedSum;
        weightField     phi;
        fields          (N2 H2O CO CO2 H2 CH4 tar);
    }

    // The gas density is not written by default; the balance needs it.
    writeRho
    {
        type            writeObjects;
        libs            ("libutilityFunctionObjects.so");
        objects         (rho);
        writeControl    writeTime;
    }

    // Axis probes: chamber bottom, mid chamber, throat, tuyere cone, shaft.
    axisProbes
    {
        type            probes;
        libs            ("libsampling.so");
        writeControl    timeStep;
        writeInterval   1;
        fields          (p U T Ts porosityF Us Ywood Ychar Ymoisture);
        probeLocations
        (
            (0 0 -0.10)
            (0 0 0.05)
            (0 0 0.20)
            (0 0 0.32)
            (0 0 0.40)
            (0 0 0.60)
            (0 0 0.90)
        );
    }
}

