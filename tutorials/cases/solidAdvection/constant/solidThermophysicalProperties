FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidThermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType solidMixtureThermo<constHeterogeneous>;

#include "../../../../thermoData/solidThermoData"

solidComponents
(
    char ash rubberwood
);

charCoeffs { $park2010Char; }

rubberwoodCoeffs
{
    transport
    {
        K           0.341; // (0.1046+0.255+0.255)/3./.6 Park2010, Asako2002
    }
    thermodynamics
    {
        Cp          1800;  // Park2010 for T=300
        Hf          -1.04e6;
    }
    density
    {
        rho          1050; // 630/0.6 Park2010
        rhoApparent 1050; // = rho: non-porous, fixture value
    }
};

ashCoeffs
{
    transport
    {
        K           0.15;
    }
    thermodynamics
    {
        Cp          2400;
        Hf          -12.38e6;
    }
    density
    {
        rho           3000;
        rhoApparent 3000; // = rho: non-porous, fixture value
    }
};

