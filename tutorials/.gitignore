processor*/
.mock_bin/
polyMesh/

spheres/
springs/
VTK/

[0-9]*/
!0*org/
!0*orig/
!**/reference/postProcessing/*/[0-9]*/

# Case output written directly at the case root by a run (function-object
# .dat files, VTK, etc. -- everything Allrun leaves behind outside 0*/).
# Not the committed reference/ baselines: re-include that directory itself
# so the rules above and below can still see inside it.
postProcessing/
!**/reference/postProcessing/

# Baselines assert the regression* volFieldValue function objects only. The
# probes FO is TUI-monitor support; its output is not part of the assertion
# surface, so keep captured probe data out of reference/.
**/reference/postProcessing/probes/

# Runtime-compiled code (codedFixedValue etc.)
dynamicCode/

# RunFunctions per-step logs (log.blockMesh, log.setFields, log.yade, ...)
log.*

# foamcli runtime state — config lives at case root as .foamcli-monitor.toml
**/.foamcli-state/

# ParaView touch files created by foam or paraFoam
*.foam

# Runtime-generated sub-case directories (created by parent Allrun scripts
# via cp -r from the template, then run inside)
cases/flatPlate/flatPlateCold/
cases/flatPlate/flatPlateHotImmediate/
cases/flatPlate/flatPlateStat/
cases/microTGA/microTGAMeanTemp/
cases/microTGA/microTGAP1/
