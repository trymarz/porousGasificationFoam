FoamFile
{
    version     2.0;
    format      ascii;
    class       volTensorField;
    location    "0";
    object      Df;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -2 0 0 0 0 0];

internalField   uniform (3e+08 0 0 0 3e+08 0 0 0 3e+08);

boundaryField
{
    wallTop
    {
        type            zeroGradient;
    }
    wallSides
    {
        type            zeroGradient;
    }

    wallBottom
    {
        type            zeroGradient;
    }

}


