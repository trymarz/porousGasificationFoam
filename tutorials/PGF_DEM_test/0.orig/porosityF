FoamFile
{
    version     2.0;
    format      binary;
    class       volScalarField;
    location    "0";
    object      porosityF;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    wallTop
    {
        type            calculated;
        value           uniform 1;
    }   
    wallSides
    {
        type            calculated;
        value           uniform 1;
    }   
    wallBottom
    {   
        type            calculated;
        value           uniform 1;
    }

}


