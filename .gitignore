# --- OpenFOAM build artifacts (what `wclean` removes) ----------------------
# **/ is required: an inner '/' anchors a pattern to this file's directory,
# so a bare Make/*/ would only match a Make/ at the repo root.
**/Make/*/
lnInclude/
platforms/
*.dep

# --- Editor / tooling indexes (per machine, hardcode absolute paths) -------
compile_commands.json
.cache/
.opencode/
.plans/
*.swp

# --- Case output ----------------------------------------------------------
*.foam
simulation_logs
dtInfo.txt
lambdaUsHistory.txt
run.log

/submodules/*-build/
/submodules/*-install/
/submodules/*-venv/

# --- Confidential site data, supplied locally (never commit) --------------
tutorials/cases/**/*.local
# Generated from the geometry table, which may read a .local file.
tutorials/cases/LEIgasifierR1/system/blockMeshDict
tutorials/cases/LEIgasifierR2/system/blockMeshDict
tutorials/cases/LEIgasifierR3/system/blockMeshDict

# --- pgf per-checkout settings (#257, #264, #274; .pgf-env.conf is the old name)
/.pgf.conf
/.pgf-env.conf
