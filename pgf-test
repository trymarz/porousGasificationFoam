#!/bin/bash
#
# pgf-test: deprecated alias (#274) for pgf test.
# what:    forwards to pgf test with the same arguments
# why:     keeps old scripts and habits working for a deprecation period
# instead: pgf test <tier|all> | --status | --gc

echo "pgf-test: deprecated; use: pgf test $*" >&2
exec "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/pgf" test "$@"
